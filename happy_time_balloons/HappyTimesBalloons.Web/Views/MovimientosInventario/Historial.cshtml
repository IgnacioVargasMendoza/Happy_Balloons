@model HappyTimesBalloons.Web.Models.ViewModels.MovimientoInventarioHistorialViewModel
@using HappyTimesBalloons.Abstraccion.Enums
@{
    ViewBag.Title = "Historial de movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4 gap-2">
        <a href="@Url.Action("Index", "Inventario")" class="btn btn-outline-secondary btn-sm" title="Volver a inventario">
            <i class="bi bi-chevron-left"></i>
        </a>
        <i class="bi bi-clock-history fs-3 text-primary ms-1"></i>
        <div>
            <h1 class="h3 mb-0">Historial de movimientos</h1>
            <p class="text-muted small mb-0">@Model.ProductoNombre</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-sm-4 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10">
                        <i class="bi bi-layers fs-4 text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Stock actual</div>
                        <div class="fs-4 fw-bold">@Model.StockActual</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10">
                        <i class="bi bi-list-check fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total movimientos</div>
                        <div class="fs-4 fw-bold">@Model.Movimientos.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">
                <i class="bi bi-table me-1 text-primary"></i>Movimientos registrados
            </span>
            <a href="@Url.Action("Index", "Inventario")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-box-seam me-1"></i>Ir a inventario
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th class="text-center">Cambio</th>
                        <th class="text-center">Stock</th>
                        <th>Motivo</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Movimientos.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-25"></i>
                                No hay movimientos registrados para este producto.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var m in Model.Movimientos)
                        {
                            string stockColor = m.StockNuevo > m.StockAnterior
                                ? "text-success"
                                : (m.StockNuevo < m.StockAnterior ? "text-danger" : "");
                            <tr>
                                <td class="text-nowrap small">
                                    @m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (m.TipoMovimiento == TipoMovimiento.Entrada)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-arrow-down-circle me-1"></i>Entrada
                                        </span>
                                    }
                                    else if (m.TipoMovimiento == TipoMovimiento.Salida)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-arrow-up-circle me-1"></i>Salida
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-clipboard-check me-1"></i>Corrección
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">
                                    @if (m.TipoMovimiento == TipoMovimiento.Salida)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            − @m.Cantidad uds
                                        </span>
                                    }
                                    else if (m.TipoMovimiento == TipoMovimiento.Entrada)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            + @m.Cantidad uds
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            + @m.Cantidad uds
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <span class="text-muted small">@m.StockAnterior</span>
                                        <i class="bi bi-arrow-right text-muted" style="font-size:.75rem"></i>
                                        <span class="fw-bold @stockColor">@m.StockNuevo</span>
                                    </div>
                                </td>
                                <td class="small">@m.Motivo</td>
                                <td class="small text-muted">@m.NombreUsuario</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Movimientos.Any())
        {
            <div class="card-footer text-muted small">
                @Model.Movimientos.Count movimiento(s) registrado(s)
            </div>
        }
    </div>

</div>
