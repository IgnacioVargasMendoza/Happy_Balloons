@model HappyTimesBalloons.Web.Models.ViewModels.ConfiguracionEditarViewModel

@{
    ViewBag.Title = "Editar Configuración";
}

<div class="mb-4">
    <h2 class="mb-0">
        <i class="bi bi-pencil-square me-2 text-brand"></i>Editar Configuración
    </h2>
    <p class="text-muted small mb-0">Modificar el valor de la regla operativa</p>
</div>

@Html.Partial("~/Views/Shared/_Mensajes.cshtml")

<div class="card shadow-sm">
    <div class="card-body">
        <form action="@Url.Action("Editar", "ReglasOperativas")" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Clave)

            <div class="mb-3">
                @Html.LabelFor(m => m.Clave, new { @class = "form-label fw-semibold" })
                <p class="form-control-plaintext">
                    <code class="text-dark fw-semibold">@Model.Clave</code>
                </p>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label text-muted" })
                <p class="text-muted small mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción." : Model.Descripcion)
                </p>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Valor, new { @class = "form-label fw-semibold" })
                <span class="text-danger">*</span>
                @Html.TextBoxFor(m => m.Valor, new { @class = "form-control", maxlength = "500" })
                @Html.ValidationMessageFor(m => m.Valor, "", new { @class = "text-danger small" })
                <div class="form-text text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Para listas separadas por coma (por ejemplo días habilitados), ingresa los valores separados por comas sin espacios: <code>1,2,3,4,5</code>
                </div>
            </div>

            @if (Model.FechaUltimaModificacion != default(System.DateTime))
            {
                <div class="mb-4">
                    <p class="text-muted small mb-0">
                        Última modificación: @Model.FechaUltimaModificacion.ToString("dd/MM/yyyy HH:mm") UTC
                        @if (!string.IsNullOrWhiteSpace(Model.UsuarioUltimaModificacion))
                        {
                            <span>por <strong>@Model.UsuarioUltimaModificacion</strong></span>
                        }
                    </p>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">
                    <i class="bi bi-check-lg me-1"></i> Guardar cambios
                </button>
                <a href="@Url.Action("Index", "ReglasOperativas")" class="btn btn-outline-secondary">
                    <i class="bi bi-chevron-left me-1"></i> Volver
                </a>
            </div>
        </form>
    </div>
</div>
