@model HappyTimesBalloons.Web.Models.ViewModels.RestablecerContrasenaViewModel
@{
    ViewBag.Title = "Nueva contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva contraseña — Happy Times Balloons</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fce4ec, #f3e5f5, #e3f2fd);
            display: flex; align-items: center; justify-content: center;
        }
        .btn-brand { background-color: #e91e8c; color: #fff; border-color: #e91e8c; }
        .btn-brand:hover { background-color: #c2177b; color: #fff; }
        .link-brand { color: #e91e8c; }
        .link-brand:hover { color: #c2177b; }
    </style>
</head>
<body>
    <div class="w-100" style="max-width:420px; padding: 1rem;">

        <div class="text-center mb-4">
            <i class="bi bi-balloon-heart-fill" style="font-size:3rem; color:#e91e8c;"></i>
            <div>
                <span class="fw-bold fs-4 lh-1">Happy Times</span><br />
                <small class="text-muted">Balloons</small>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-1">Nueva contraseña</h5>
                <p class="text-muted small mb-4">Elige una contraseña de al menos 6 caracteres.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })
                }

                @using (Html.BeginForm("RestablecerContrasena", "Cuenta", FormMethod.Post,
                    new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Token)

                    <div class="mb-3">
                        @Html.LabelFor(m => m.NuevaContrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.NuevaContrasena, new { @class = "form-control", placeholder = "••••••••", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.NuevaContrasena, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmarContrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.ConfirmarContrasena, new { @class = "form-control", placeholder = "••••••••", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.ConfirmarContrasena, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-brand w-100">
                        <i class="bi bi-lock-fill me-1"></i> Guardar nueva contraseña
                    </button>
                }

                <hr class="my-3" />

                <a href="@Url.Action("Login", "Cuenta")" class="btn btn-outline-secondary w-100 btn-sm">
                    <i class="bi bi-chevron-left me-1"></i> Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>
</html>
