@{
    ViewBag.Title = "Enlace enviado";
    Layout = null;
    var email = TempData["Email"] as string;
    var urlReset = TempData["UrlReset"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enlace enviado — Happy Times Balloons</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fce4ec, #f3e5f5, #e3f2fd);
            display: flex; align-items: center; justify-content: center;
        }
        .link-brand { color: #e91e8c; }
        .link-brand:hover { color: #c2177b; }
    </style>
</head>
<body>
    <div class="w-100" style="max-width:460px; padding: 1rem;">

        <div class="text-center mb-4">
            <i class="bi bi-balloon-heart-fill" style="font-size:3rem; color:#e91e8c;"></i>
            <div>
                <span class="fw-bold fs-4 lh-1">Happy Times</span><br />
                <small class="text-muted">Balloons</small>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-check-fill text-success mb-3" style="font-size:3rem;"></i>
                <h5 class="fw-bold mb-2">Revisa tu correo</h5>
                <p class="text-muted small mb-3">
                    Si <strong>@(email ?? "tu correo")</strong> está registrado,
                    recibirás un enlace de recuperación en los próximos minutos.
                </p>

                @if (!string.IsNullOrEmpty(urlReset))
                {
                    <div class="alert alert-info py-2 small text-start mb-3">
                        <div class="fw-semibold mb-1">
                            <i class="bi bi-info-circle me-1"></i>Modo de desarrollo
                        </div>
                        <div class="text-muted mb-1">
                            SMTP no configurado. Usa este enlace directamente:
                        </div>
                        <a href="@urlReset" class="link-brand text-break small">@urlReset</a>
                    </div>
                }

                <a href="@Url.Action("Login", "Cuenta")" class="btn btn-outline-secondary w-100 btn-sm">
                    <i class="bi bi-chevron-left me-1"></i> Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>
</html>
