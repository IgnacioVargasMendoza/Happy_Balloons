@{
    ViewBag.Title = "Enlace enviado";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enlace enviado — Happy Times Balloons</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fce4ec, #f3e5f5, #e3f2fd);
            display: flex; align-items: center; justify-content: center;
        }
        .link-brand { color: #e91e8c; }
        .link-brand:hover { color: #c2177b; }
    </style>
</head>
<body>
    <div class="w-100" style="max-width:480px; padding: 1rem;">

        <div class="text-center mb-4">
            <i class="bi bi-balloon-heart-fill" style="font-size:3rem; color:#e91e8c;"></i>
            <div>
                <span class="fw-bold fs-4 lh-1">Happy Times</span><br />
                <small class="text-muted">Balloons</small>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-check-fill text-success" style="font-size:3rem;"></i>
                <h5 class="fw-bold mt-3 mb-1">Revisa tu correo</h5>

                @if (ViewBag.Email != null)
                {
                    <p class="text-muted small mb-3">
                        Si <strong>@ViewBag.Email</strong> está registrado, recibirás
                        un enlace válido por 60 minutos.
                    </p>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Si el correo está registrado, recibirás un enlace válido por 60 minutos.
                    </p>
                }

                @* Enlace de prueba — solo en modo desarrollo *@
                @if (ViewBag.Enlace != null)
                {
                    <div class="alert alert-warning py-2 text-start small">
                        <div class="fw-semibold mb-1">
                            <i class="bi bi-cone-striped me-1"></i>Modo desarrollo — enlace de reset:
                        </div>
                        <a href="@ViewBag.Enlace" class="link-brand text-break">@ViewBag.Enlace</a>
                    </div>
                }

                <a href="@Url.Action("Login", "Cuenta")" class="btn btn-outline-secondary w-100 btn-sm mt-2">
                    Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmQ3Q5kAQ+ROmuAKCNEVXKCkuBBD"
            crossorigin="anonymous"></script>
</body>
</html>
