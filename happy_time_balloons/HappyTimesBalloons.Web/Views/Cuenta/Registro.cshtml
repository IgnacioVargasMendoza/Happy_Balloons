@model HappyTimesBalloons.Web.Models.ViewModels.RegistroViewModel
@{
    ViewBag.Title = "Crear cuenta";
    Layout = null; // Página standalone con fondo degradado
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta — Happy Times Balloons</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fce4ec, #f3e5f5, #e3f2fd);
            display: flex; align-items: center; justify-content: center;
        }
        .btn-brand { background-color: #e91e8c; color: #fff; border-color: #e91e8c; }
        .btn-brand:hover { background-color: #c2177b; color: #fff; }
        .link-brand { color: #e91e8c; }
        .link-brand:hover { color: #c2177b; }
    </style>
</head>
<body>
    <div class="w-100" style="max-width:460px; padding: 1rem;">

        <!-- Logo -->
        <div class="text-center mb-4">
            <i class="bi bi-balloon-heart-fill" style="font-size:3rem; color:#e91e8c;"></i>
            <div>
                <span class="fw-bold fs-4 lh-1">Happy Times</span><br />
                <small class="text-muted">Balloons</small>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-1">Crear cuenta</h5>
                <p class="text-muted small mb-4">Completa todos los campos para registrarte</p>

                @* HU-CLI-001 Escenario 2: email duplicado u otros errores *@
                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })
                }

                @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post,
                    new { @class = "row g-3" }))
                {
                    @Html.AntiForgeryToken()

                    @* Nombre *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Juan Pérez" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                    </div>

                    @* Email *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ejemplo@correo.com", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    @* Contraseña *@
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Contrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", placeholder = "••••••••" })
                        @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                    </div>

                    @* Confirmar contraseña *@
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmarContrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.ConfirmarContrasena, new { @class = "form-control", placeholder = "••••••••" })
                        @Html.ValidationMessageFor(m => m.ConfirmarContrasena, "", new { @class = "text-danger small" })
                    </div>

                    @* Teléfono *@
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Telefono, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", placeholder = "8888-8888", type = "tel" })
                        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                    </div>

                    @* Dirección (opcional) *@
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Direccion, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", placeholder = "San José, Costa Rica" })
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-brand w-100">
                            Crear cuenta
                        </button>
                    </div>
                }

                <hr class="my-3" />
                <p class="text-center small text-muted mb-0">
                    ¿Ya tienes cuenta?
                    <a href="@Url.Action("Login", "Cuenta")" class="link-brand fw-semibold">
                        Inicia sesión aquí
                    </a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>
</html>
