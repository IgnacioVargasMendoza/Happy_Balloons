@model HappyTimesBalloons.Web.Models.ViewModels.EditarPerfilViewModel
@{
    ViewBag.Title = "Editar perfil";
}

<div class="d-flex align-items-center mb-4">
    <a href="@Url.Action("Index", "Configuracion")" class="btn btn-outline-secondary me-3" title="Volver">
        <i class="bi bi-chevron-left"></i>
    </a>
    <div>
        <h2 class="mb-0"><i class="bi bi-person-circle me-2 text-brand"></i>Editar perfil</h2>
        <p class="text-muted small mb-0">Actualiza tu información personal</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("EditarPerfil", "Configuracion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Nombre, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Telefono, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", placeholder = "Ej: +52 55 1234 5678" })
                        @Html.ValidationMessageFor(m => m.Telefono, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Direccion, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Direccion, 2, 0, new { @class = "form-control", placeholder = "Calle, número, colonia, ciudad" })
                        @Html.ValidationMessageFor(m => m.Direccion, null, new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Index", "Configuracion")" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-brand">
                            <i class="bi bi-check-lg me-1"></i>Guardar cambios
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
