@model HappyTimesBalloons.Web.Models.ViewModels.CambiarContrasenaViewModel
@{
    ViewBag.Title = "Cambiar contraseña";
}

<div class="d-flex align-items-center mb-4">
    <a href="@Url.Action("Index", "Configuracion")" class="btn btn-outline-secondary me-3" title="Volver">
        <i class="bi bi-chevron-left"></i>
    </a>
    <div>
        <h2 class="mb-0"><i class="bi bi-key me-2 text-brand"></i>Cambiar contraseña</h2>
        <p class="text-muted small mb-0">Actualiza tu contraseña de acceso</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("CambiarContrasena", "Configuracion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContrasenaActual, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.ContrasenaActual, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ContrasenaActual, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.NuevaContrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.NuevaContrasena, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NuevaContrasena, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmarContrasena, new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.ConfirmarContrasena, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ConfirmarContrasena, null, new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Index", "Configuracion")" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-brand">
                            <i class="bi bi-check-lg me-1"></i>Actualizar contraseña
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
