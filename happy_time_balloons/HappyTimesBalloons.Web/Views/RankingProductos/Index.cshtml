@model HappyTimesBalloons.Web.Models.ViewModels.RankingProductosViewModel
@{
    ViewBag.Title = "Ranking de Productos Más Vendidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/ranking-productos.css")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">
                <i class="bi bi-trophy me-2 text-warning"></i>Ranking de Productos
            </h2>
            <p class="text-muted small mb-0">Productos más vendidos por unidades en el período seleccionado</p>
        </div>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="card mb-4">
        <div class="card-body">
            <form action="@Url.Action("Index", "RankingProductos")" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="fechaInicio" class="form-label fw-semibold">Fecha inicio</label>
                    <input type="date" id="fechaInicio" name="fechaInicio"
                           class="form-control"
                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label for="fechaFin" class="form-label fw-semibold">Fecha fin</label>
                    <input type="date" id="fechaFin" name="fechaFin"
                           class="form-control"
                           value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label for="zonaId" class="form-label fw-semibold">Zona de entrega</label>
                    <select id="zonaId" name="zonaId" class="form-select">
                        <option value="">Todas las zonas</option>
                        @foreach (System.Web.Mvc.SelectListItem zona in Model.Zonas)
                        {
                            if (zona.Selected)
                            {
                                <option value="@zona.Value" selected="selected">@zona.Text</option>
                            }
                            else
                            {
                                <option value="@zona.Value">@zona.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    @if (Model.FiltroAplicado)
                    {
                        <a href="@Url.Action("Index", "RankingProductos")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.TieneDatos)
    {
        <div class="text-center py-5">
            <i class="bi bi-bar-chart-line fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No hay datos para el período seleccionado</h5>
            <p class="text-muted small">
                @Model.FechaInicio.ToString("dd/MM/yyyy") — @Model.FechaFin.ToString("dd/MM/yyyy")
            </p>
            @if (Model.FiltroAplicado)
            {
                <a href="@Url.Action("Index", "RankingProductos")" class="btn btn-outline-secondary btn-sm mt-2">
                    <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                </a>
            }
        </div>
    }
    else
    {
        @* Contenedor de datos para Chart.js; los valores Razor se pasan via data-* al JS externo *@
        <div id="ranking-charts-data" class="d-none"
             data-etiquetas="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Ranking.GraficoEtiquetas)"
             data-unidades="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Ranking.GraficoUnidades)"
             data-dona-etiquetas="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Ranking.DonaEtiquetas)"
             data-dona-valores="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Ranking.DonaValores)">
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-box-seam fs-2"></i>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Ranking.TotalUnidadesVendidas.ToString("N0")</div>
                            <div class="small opacity-75">Total unidades vendidas</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-currency-dollar fs-2"></i>
                        <div>
                            <div class="fs-4 fw-bold">&#8353;@Model.Ranking.IngresosTotales.ToString("N2")</div>
                            <div class="small opacity-75">Ingresos totales</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-info h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-grid fs-2"></i>
                        <div>
                            <div class="fs-4 fw-bold">@Model.Ranking.TotalProductosActivos</div>
                            <div class="small opacity-75">Productos con ventas</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Top 10 — Unidades vendidas
                    </div>
                    <div class="card-body">
                        <canvas id="chartBarras" height="100"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-pie-chart-fill me-2 text-info"></i>Distribución por categoría
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <canvas id="chartDona"></canvas>
                    </div>
                </div>
            </div>
        </div>
    
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-list-ol me-2"></i>Ranking completo</span>
                @if (Model.Ranking.NombreZona != null)
                {
                    <span class="badge bg-secondary">Zona: @Model.Ranking.NombreZona</span>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center ranking-col-posicion">#</th>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-end">Unidades</th>
                                <th class="ranking-col-progreso">% del total</th>
                                <th class="text-end">Ingresos</th>
                                <th class="text-center">Pedidos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Ranking.Items)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        @if (item.Posicion == 1)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">&#x1F947;</span>
                                        }
                                        else if (item.Posicion == 2)
                                        {
                                            <span class="badge bg-secondary fs-6">&#x1F948;</span>
                                        }
                                        else if (item.Posicion == 3)
                                        {
                                            <span class="badge text-white fs-6 ranking-badge-bronce">&#x1F949;</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@item.Posicion</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">@item.NombreProducto</td>
                                    <td><span class="badge bg-light text-dark border">@item.Categoria</span></td>
                                    <td class="text-end fw-bold">@item.UnidadesVendidas.ToString("N0")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1 ranking-progress">
                                                <div class="progress-bar bg-primary"
                                                     style="width:@(item.PorcentajeUnidades.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                                                     role="progressbar"
                                                     aria-valuenow="@item.PorcentajeUnidades"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small text-muted">@item.PorcentajeUnidades.ToString("F1")%</span>
                                        </div>
                                    </td>
                                    <td class="text-end">&#8353;@item.Ingresos.ToString("N2")</td>
                                    <td class="text-center">@item.NumeroPedidos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.TieneDatos)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="@Url.Content("~/Scripts/ranking-productos.js")"></script>
    }
}
