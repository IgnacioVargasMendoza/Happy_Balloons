@model HappyTimesBalloons.Web.Models.ViewModels.ZonaEntregaViewModel

@{
    ViewBag.Title = "Editar Zona de Entrega";
}

<div class="mb-4">
    <h2 class="mb-0">
        <i class="bi bi-pencil-square me-2 text-brand"></i>Editar Zona de Entrega
    </h2>
    <p class="text-muted small mb-0">Modificar los datos de la zona de entrega</p>
</div>

@Html.Partial("~/Views/Shared/_Mensajes.cshtml")

<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Editar", "ZonasEntrega", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                <span class="text-danger">*</span>
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "100" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(m => m.Descripcion, 3, 0, new { @class = "form-control", maxlength = "500" })
                @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.CostoEnvio, new { @class = "form-label fw-semibold" })
                <span class="text-danger">*</span>
                @Html.TextBoxFor(m => m.CostoEnvio, new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "99999.99" })
                @Html.ValidationMessageFor(m => m.CostoEnvio, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <p class="text-muted small mb-1">
                    <i class="bi bi-info-circle me-1"></i>
                    Para cambiar la disponibilidad usa el botón de activar/desactivar en la lista.
                </p>
            </div>

            <div class="mb-4">
                <p class="text-muted small mb-0">
                    Creada el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm") UTC
                </p>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">
                    <i class="bi bi-check-lg me-1"></i> Guardar cambios
                </button>
                <a href="@Url.Action("Index", "ZonasEntrega")" class="btn btn-outline-secondary">
                    <i class="bi bi-chevron-left me-1"></i> Volver
                </a>
            </div>
        }
    </div>
</div>
