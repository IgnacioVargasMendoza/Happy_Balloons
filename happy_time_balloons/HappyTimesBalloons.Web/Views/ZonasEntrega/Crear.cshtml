@model HappyTimesBalloons.Web.Models.ViewModels.ZonaEntregaViewModel

@{
    ViewBag.Title = "Nueva Zona de Entrega";
}

<div class="mb-4">
    <h2 class="mb-0">
        <i class="bi bi-geo-alt-fill me-2 text-brand"></i>Nueva Zona de Entrega
    </h2>
    <p class="text-muted small mb-0">Registrar una nueva zona de entrega con su tarifa</p>
</div>

@Html.Partial("~/Views/Shared/_Mensajes.cshtml")

<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Crear", "ZonasEntrega", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                <span class="text-danger">*</span>
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "100", placeholder = "Ej: San José Centro" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(m => m.Descripcion, 3, 0, new { @class = "form-control", maxlength = "500", placeholder = "Descripción opcional de la zona" })
                @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.CostoEnvio, new { @class = "form-label fw-semibold" })
                <span class="text-danger">*</span>
                @Html.TextBoxFor(m => m.CostoEnvio, new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "99999.99", placeholder = "0.00" })
                @Html.ValidationMessageFor(m => m.CostoEnvio, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-4">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.EsDisponible, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.EsDisponible, new { @class = "form-check-label" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">
                    <i class="bi bi-check-lg me-1"></i> Crear zona
                </button>
                <a href="@Url.Action("Index", "ZonasEntrega")" class="btn btn-outline-secondary">
                    <i class="bi bi-chevron-left me-1"></i> Volver
                </a>
            </div>
        }
    </div>
</div>
