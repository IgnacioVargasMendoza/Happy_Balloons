@model HappyTimesBalloons.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-speedometer2 me-2 text-brand"></i>Dashboard</h2>
        <p class="text-muted small mb-0">Panel de administración</p>
    </div>
    <span class="text-muted small"><i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
</div>

@* ── Tarjetas de estadísticas ── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-brand-soft text-brand fs-4">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalProductos</div>
                    <div class="text-muted small">Productos</div>
                    <div class="text-success" style="font-size:.75rem;">@Model.ProductosActivos activos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning fs-4">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.ProductosConBajoStock</div>
                    <div class="text-muted small">Bajo stock</div>
                    <div class="text-muted" style="font-size:.75rem;">5 unidades o menos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info fs-4">
                    <i class="bi bi-tags"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalCategorias</div>
                    <div class="text-muted small">Categorías</div>
                    <div class="text-success" style="font-size:.75rem;">@Model.CategoriasActivas activas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-4">
                    <i class="bi bi-bag-check"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.PedidosHoy</div>
                    <div class="text-muted small">Pedidos hoy</div>
                    <div class="text-muted" style="font-size:.75rem;">@Model.TotalPedidos en total</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* ── Actividad reciente ── *@
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-activity text-brand"></i>
                <span class="fw-semibold">Actividad reciente</span>
            </div>
            @if (!Model.ActividadReciente.Any())
            {
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 opacity-25 d-block mb-2"></i>
                    <p class="mb-0">No hay actividad registrada.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Fecha</th>
                                <th>Usuario</th>
                                <th>Acción</th>
                                <th>Tabla</th>
                                <th class="pe-3">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entrada in Model.ActividadReciente)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">
                                        @entrada.FechaHoraUtc.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>@entrada.NombreUsuario</td>
                                    <td>
                                        @{
                                            string badgeCss;
                                            if (entrada.Accion == "Crear") { badgeCss = "bg-success"; }
                                            else if (entrada.Accion == "Actualizar") { badgeCss = "bg-primary"; }
                                            else if (entrada.Accion == "Eliminar") { badgeCss = "bg-danger"; }
                                            else { badgeCss = "bg-secondary"; }                                 
                                        }
                                        <span class="badge @badgeCss">@entrada.Accion</span>
                                    </td>
                                    <td class="text-muted">@entrada.TablaAfectada</td>
                                    <td class="pe-3 text-muted text-truncate" style="max-width:180px;">
                                        @entrada.Detalle
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Acceso rápido ── *@
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-lightning text-brand"></i>
                <span class="fw-semibold">Acceso rápido</span>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                @Html.ActionLink("Gestión de productos", "Index", "Producto",
                    null, new { @class = "btn btn-outline-secondary text-start w-100 d-flex align-items-center gap-2" })

                @Html.ActionLink("Gestión de categorías", "Index", "Categoria",
                    null, new { @class = "btn btn-outline-secondary text-start w-100 d-flex align-items-center gap-2" })

                @Html.ActionLink("Gestión de inventario", "Index", "Inventario",
                    null, new { @class = "btn btn-outline-secondary text-start w-100 d-flex align-items-center gap-2" })

                <a href="@Url.Action("Index", "Pedido")"
                   class="btn btn-outline-secondary text-start w-100 d-flex align-items-center justify-content-between gap-2">
                    <span>Gestión de pedidos</span>
                    @if (Model.TotalPedidos == 0)
                    {
                        <span class="badge bg-secondary">Próximamente</span>
                    }
                </a>

                @Html.ActionLink("Promociones y descuentos", "Index", "Promocion",
                    null, new { @class = "btn btn-outline-danger text-start w-100 d-flex align-items-center gap-2" })
            </div>
        </div>
    </div>
</div>
