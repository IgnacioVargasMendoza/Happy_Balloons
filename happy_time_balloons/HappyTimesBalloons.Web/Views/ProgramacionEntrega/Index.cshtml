@model HappyTimesBalloons.Web.Models.ViewModels.ProgramacionEntregaIndexViewModel
@using HappyTimesBalloons.Abstraccion.Enums

@{
    ViewBag.Title = "Programación de Entregas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-calendar-check me-2 text-primary"></i>Programación de Entregas
    </h2>
</div>

@* Sección: pedidos que aún no tienen entrega programada (#46) *@
@if (Model.PedidosSinProgramar.Any())
{
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center">
            <i class="bi bi-exclamation-circle text-warning me-2"></i>
            <span class="fw-semibold">Pedidos pendientes de programar (@Model.PedidosSinProgramar.Count)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Número</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th class="text-center pe-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PedidosSinProgramar)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@p.Numero</td>
                                <td class="small">@(p.NombreUsuario ?? "—")</td>
                                <td class="text-muted small">@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @{
                                        string estadoCss;
                                        switch (p.EstadoPedido)
                                        {
                                            case EstadoPedido.Pendiente:
                                                estadoCss = "bg-warning text-dark";
                                                break;
                                            case EstadoPedido.Procesando:
                                                estadoCss = "bg-info text-dark";
                                                break;
                                            case EstadoPedido.PagoPendiente:
                                                estadoCss = "bg-secondary";
                                                break;
                                            default:
                                                estadoCss = "bg-light text-dark";
                                                break;
                                        }
                                    }
                                    <span class="badge @estadoCss">@p.EstadoPedido</span>
                                </td>
                                <td class="text-end fw-semibold">₡@p.Total.ToString("N0")</td>
                                <td class="text-center pe-3">
                                    <a href="@Url.Action("Programar", "ProgramacionEntrega", new { pedidoId = p.Id })"
                                       class="btn btn-sm btn-success">
                                        <i class="bi bi-calendar-plus me-1"></i>Programar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* Sección: programaciones existentes *@
@if (!Model.Programaciones.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No hay entregas programadas todavía. Puedes programar una entrega desde la pantalla de <strong>Pedidos</strong> o desde la tabla de arriba.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header">
            <span class="fw-semibold"><i class="bi bi-list-check me-2 text-primary"></i>Entregas programadas</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha de Entrega</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th>Programado por</th>
                            <th>Notas</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Programaciones)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@p.NumeroPedido</span>
                                </td>
                                <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                                <td>@p.EtiquetaHorario</td>
                                <td>
                                    @{
                                        string badgeClass;
                                        switch (p.EstadoProgramacion)
                                        {
                                            case EstadoProgramacionEntrega.Confirmada:
                                                badgeClass = "bg-success";
                                                break;
                                            case EstadoProgramacionEntrega.Entregada:
                                                badgeClass = "bg-primary";
                                                break;
                                            case EstadoProgramacionEntrega.Cancelada:
                                                badgeClass = "bg-secondary";
                                                break;
                                            default:
                                                badgeClass = "bg-warning text-dark";
                                                break;
                                        }
                                    }
                                    <span class="badge @badgeClass">@p.EstadoProgramacion</span>
                                </td>
                                <td>@p.NombreUsuario</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.Notas))
                                    {
                                        <span class="text-muted small" title="@p.Notas">
                                            @(p.Notas.Length > 40 ? p.Notas.Substring(0, 40) + "…" : p.Notas)
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (p.EstadoProgramacion != EstadoProgramacionEntrega.Cancelada
                                         && p.EstadoProgramacion != EstadoProgramacionEntrega.Entregada)
                                    {
                                        <form action="@Url.Action("MarcarEntregada", "ProgramacionEntrega")" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Marcar esta entrega como completada? El pedido pasará a estado Entregado.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-success" title="Marcar como entregada">
                                                <i class="bi bi-check-circle"></i> Entregada
                                            </button>
                                        </form>
                                        <form action="@Url.Action("Cancelar", "ProgramacionEntrega")" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Cancelar esta programación de entrega? El pedido volverá a estado Procesando.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar entrega">
                                                <i class="bi bi-x-circle"></i> Cancelar
                                            </button>
                                        </form>
                                    }
                                    else if (p.EstadoProgramacion == EstadoProgramacionEntrega.Cancelada)
                                    {
                                        <a href="@Url.Action("Programar", "ProgramacionEntrega", new { pedidoId = p.PedidoId })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Reprogramar entrega">
                                            <i class="bi bi-calendar-plus me-1"></i>Reprogramar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
