@model HappyTimesBalloons.Web.Models.ViewModels.ProgramacionEntregaIndexViewModel
@using HappyTimesBalloons.Abstraccion.Enums

@{
    ViewBag.Title = "Programación de Entregas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-calendar-check me-2 text-primary"></i>Programación de Entregas
    </h2>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs px-3" id="tabsEntregas" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-activas" data-bs-toggle="tab"
                        data-bs-target="#panel-activas" type="button" role="tab">
                    <i class="bi bi-calendar2-check me-1"></i>Entregas activas
                    @if (Model.PedidosSinProgramar.Any())
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.PedidosSinProgramar.Count sin programar</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-historial" data-bs-toggle="tab"
                        data-bs-target="#panel-historial" type="button" role="tab">
                    <i class="bi bi-clock-history me-1"></i>Historial
                    <span class="badge bg-secondary ms-1">@Model.ProgramacionesHistorial.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="tabsEntregasContent">

        @* ── Tab 1: Entregas activas ── *@
        <div class="tab-pane fade show active" id="panel-activas" role="tabpanel">

            @* Pedidos sin programar *@
            @if (Model.PedidosSinProgramar.Any())
            {
                <div class="px-3 pt-3">
                    <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 flex-shrink-0"></i>
                        <span>Hay <strong>@Model.PedidosSinProgramar.Count pedido(s)</strong> que aún no tienen entrega programada.</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Número</th>
                                <th>Cliente</th>
                                <th>Fecha pedido</th>
                                <th>Estado</th>
                                <th class="text-end">Total</th>
                                <th class="text-center pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PedidosSinProgramar)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@p.Numero</td>
                                    <td class="small">@(p.NombreUsuario ?? "—")</td>
                                    <td class="text-muted small">@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            string estadoCss;
                                            switch (p.EstadoPedido)
                                            {
                                                case EstadoPedido.Pendiente:
                                                    estadoCss = "bg-warning text-dark";
                                                    break;
                                                case EstadoPedido.Procesando:
                                                    estadoCss = "bg-info text-dark";
                                                    break;
                                                case EstadoPedido.PagoPendiente:
                                                    estadoCss = "bg-secondary";
                                                    break;
                                                default:
                                                    estadoCss = "bg-light text-dark";
                                                    break;
                                            }
                                        }
                                        <span class="badge @estadoCss">@p.EstadoPedido</span>
                                    </td>
                                    <td class="text-end fw-semibold">₡@p.Total.ToString("N0")</td>
                                    <td class="text-center pe-4">
                                        <a href="@Url.Action("Programar", "ProgramacionEntrega", new { pedidoId = p.Id })"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-calendar-plus me-1"></i>Programar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                if (Model.ProgramacionesActivas.Any())
                {
                    <hr class="my-0" />
                }
            }

            @* Programaciones activas *@
            @if (!Model.ProgramacionesActivas.Any() && !Model.PedidosSinProgramar.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-calendar2-check fs-3 d-block mb-2 opacity-25"></i>
                    No hay entregas activas en este momento.
                </div>
            }
            else if (Model.ProgramacionesActivas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Pedido</th>
                                <th>Fecha de entrega</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th>Programado por</th>
                                <th class="pe-4">Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.ProgramacionesActivas)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@p.NumeroPedido</td>
                                    <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                                    <td>@p.EtiquetaHorario</td>
                                    <td>
                                        <span class="badge bg-success">@p.EstadoProgramacion</span>
                                    </td>
                                    <td class="small">@p.NombreUsuario</td>
                                    <td class="pe-4">
                                        @if (!string.IsNullOrEmpty(p.Notas))
                                        {
                                            <span class="text-muted small" title="@p.Notas">
                                                @(p.Notas.Length > 40 ? p.Notas.Substring(0, 40) + "…" : p.Notas)
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ── Tab 2: Historial ── *@
        <div class="tab-pane fade" id="panel-historial" role="tabpanel">
            @if (!Model.ProgramacionesHistorial.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-clock-history fs-3 d-block mb-2 opacity-25"></i>
                    No hay entregas en el historial todavía.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Pedido</th>
                                <th>Fecha de entrega</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th>Programado por</th>
                                <th class="pe-4">Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.ProgramacionesHistorial)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@p.NumeroPedido</td>
                                    <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                                    <td>@p.EtiquetaHorario</td>
                                    <td>
                                        @{
                                            string badgeHistorial = p.EstadoProgramacion == EstadoProgramacionEntrega.Entregada
                                                ? "bg-primary"
                                                : "bg-secondary";
                                        }
                                        <span class="badge @badgeHistorial">@p.EstadoProgramacion</span>
                                    </td>
                                    <td class="small">@p.NombreUsuario</td>
                                    <td class="small text-muted pe-4">
                                        @if (!string.IsNullOrEmpty(p.Notas))
                                        {
                                            <span title="@p.Notas">
                                                @(p.Notas.Length > 40 ? p.Notas.Substring(0, 40) + "…" : p.Notas)
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    @Model.ProgramacionesHistorial.Count entrega(s) en historial
                </div>
            }
        </div>

    </div>
</div>
