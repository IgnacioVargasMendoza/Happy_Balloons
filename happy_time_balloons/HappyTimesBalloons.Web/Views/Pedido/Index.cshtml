@model HappyTimesBalloons.Web.Models.ViewModels.GestionPedidosViewModel
@using HappyTimesBalloons.Abstraccion.Enums
@{
    ViewBag.Title = "Gestión de pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-clipboard-list me-2 text-brand"></i>Gestión de pedidos</h2>
        <p class="text-muted small mb-0">Administra y actualiza el estado de los pedidos</p>
    </div>
</div>

@* Filtros *@
@using (Html.BeginForm("Index", "Pedido", FormMethod.Get))
{
    <div class="row g-2 mb-4">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="filtroBusqueda" class="form-control border-start-0"
                       placeholder="Buscar por número o cliente..."
                       value="@Model.FiltroBusqueda" />
            </div>
        </div>
        <div class="col-md-3">
            @Html.DropDownList("filtroEstado", Model.EstadosDisponibles,
                new { @class = "form-select" })
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(Model.FiltroBusqueda) || !string.IsNullOrEmpty(Model.FiltroEstado))
            {
                @Html.ActionLink("Limpiar", "Index", "Pedido", null,
                    new { @class = "btn btn-outline-danger ms-1" })
            }
        </div>
    </div>
}

@* Tabla *@
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Número</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Pedidos.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-clipboard-x fs-3 d-block mb-2 opacity-25"></i>
                            <span>No se encontraron pedidos con los filtros aplicados</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model.Pedidos)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@p.Numero</td>
                            <td>
                                <div class="small">@(p.NombreUsuario ?? "—")</div>
                            </td>
                            <td class="text-muted small">
                                @p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @p.EstadoCss">@p.EstadoTexto</span>
                            </td>
                            <td class="text-end fw-semibold">₡@p.Total.ToString("N0")</td>
                            <td class="text-end pe-4">
                                @Html.ActionLink("Ver", "Detalle", "Pedido",
                                    new { id = p.Id },
                                    new { @class = "btn btn-sm btn-outline-primary me-1" })

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEstado"
                                        data-pedido-id="@p.Id"
                                        data-pedido-numero="@p.Numero"
                                        data-estado-actual="@((int)p.EstadoPedido)">
                                    <i class="bi bi-arrow-repeat me-1"></i>Estado
                                </button>

                                <a href="@Url.Action("Programar", "ProgramacionEntrega", new { pedidoId = p.Id })"
                                   class="btn btn-sm btn-outline-success ms-1"
                                   title="Programar entrega">
                                    <i class="bi bi-calendar-plus"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Pedidos.Any())
    {
        <div class="card-footer text-muted small">
            @Model.Pedidos.Count pedido(s) encontrado(s)
        </div>
    }
</div>

@* Modal cambiar estado *@
<div class="modal fade" id="modalEstado" tabindex="-1" aria-labelledby="modalEstadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEstadoLabel">
                    <i class="bi bi-arrow-repeat me-2 text-brand"></i>Cambiar estado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            @using (Html.BeginForm("ActualizarEstado", "Pedido", FormMethod.Post, new { id = "formEstado" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Pedido: <strong id="modalNumero">—</strong>
                    </p>
                    <input type="hidden" name="id" id="modalPedidoId" value="" />
                    <label class="form-label fw-semibold">Nuevo estado</label>
                    <select name="estado" id="selectEstado" class="form-select">
                        <option value="@((int)EstadoPedido.Pendiente)">Pendiente</option>
                        <option value="@((int)EstadoPedido.Procesando)">Procesando</option>
                        <option value="@((int)EstadoPedido.Enviado)">Enviado</option>
                        <option value="@((int)EstadoPedido.Entregado)">Entregado</option>
                        <option value="@((int)EstadoPedido.Cancelado)">Cancelado</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-brand btn-sm">
                        <i class="bi bi-check me-1"></i>Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
<script>
    var modalEl = document.getElementById('modalEstado');
    modalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('modalPedidoId').value  = btn.dataset.pedidoId;
        document.getElementById('modalNumero').textContent = btn.dataset.pedidoNumero;
        document.getElementById('selectEstado').value  = btn.dataset.estadoActual;
    });
</script>
}
