@model HappyTimesBalloons.Web.Models.ViewModels.CarritoViewModel
@{
    ViewBag.Title = "Mi carrito";
}

<div class="d-flex align-items-center mb-4">
    <h2 class="mb-0 me-2">
        <i class="bi bi-cart3 me-2 text-brand"></i>Mi carrito
    </h2>
    @if (!Model.EstaVacio)
    {
        <span class="badge bg-danger rounded-pill">@Model.CantidadTotal</span>
    }
</div>

@if (Model.EstaVacio)
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x fs-1 text-muted opacity-25 d-block mb-3"></i>
        <p class="text-muted mb-3">Tu carrito está vacío.</p>
        @Html.ActionLink("Ver catálogo", "Index", "Home", null,
            new { @class = "btn btn-brand" })
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width:72px;"></th>
                                <th>Producto</th>
                                <th class="text-center" style="width:160px;">Cantidad</th>
                                <th class="text-end pe-3">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="@item.Nombre"
                                                 class="rounded"
                                                 style="width:56px;height:56px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                 style="width:56px;height:56px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Nombre</div>
                                        @if (item.PrecioDescuento.HasValue && item.PrecioDescuento < item.Precio)
                                        {
                                            <div class="text-muted small text-decoration-line-through">
                                                ₡@item.Precio.ToString("N0")
                                            </div>
                                            <div class="small text-success">₡@item.PrecioDescuento.Value.ToString("N0")</div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">₡@item.Precio.ToString("N0")</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            @using (Html.BeginForm("ActualizarCantidad", "Pedido", FormMethod.Post,
                                                new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                <input type="hidden" name="cantidad" value="@(item.Cantidad - 1)" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        @(item.Cantidad <= 1 ? Html.Raw("disabled") : Html.Raw(""))>
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                            }
                                            <span class="px-2 fw-semibold">@item.Cantidad</span>
                                            @using (Html.BeginForm("ActualizarCantidad", "Pedido", FormMethod.Post,
                                                new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                <input type="hidden" name="cantidad" value="@(item.Cantidad + 1)" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="fw-semibold">₡@item.Subtotal.ToString("N0")</div>
                                        @using (Html.BeginForm("QuitarDelCarrito", "Pedido", FormMethod.Post,
                                            new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productoId" value="@item.ProductoId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger mt-1"
                                                    title="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-2">
                @Html.ActionLink("← Seguir comprando", "Index", "Home", null,
                    new { @class = "text-brand text-decoration-none small" })
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-semibold">
                    Resumen del pedido
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal (@Model.CantidadTotal artículos)</span>
                        <span>₡@Model.Total.ToString("N0")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5 text-brand">₡@Model.Total.ToString("N0")</span>
                    </div>

                    @if (Request.IsAuthenticated)
                    {
                        @Html.ActionLink("Ir al pago", "Checkout", "Pedido",
                            null, new { @class = "btn btn-brand w-100" })
                    }
                    else
                    {
                        @Html.ActionLink("Iniciar sesión para continuar", "Login", "Cuenta",
                            new { returnUrl = Url.Action("Checkout", "Pedido") },
                            new { @class = "btn btn-brand w-100" })
                    }
                </div>
            </div>
        </div>
    </div>
}
