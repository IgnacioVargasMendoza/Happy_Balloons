@model List<HappyTimesBalloons.Abstraccion.DTOs.CatalogoProductoDTO>

@{
    ViewBag.Title = "Catálogo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            <i class="bi bi-grid me-2 text-brand"></i>
            Catálogo de Productos
        </h2>

        <p class="text-muted small mb-0">
            Explora nuestros productos disponibles
        </p>
    </div>
</div>

@using (Html.BeginForm("Index", "Catalogo", FormMethod.Get))
{
    <div class="row g-2 mb-4">

        <div class="col-md-5">
            <div class="input-group">

                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-muted"></i>
                </span>

                <input type="text"
                       name="busqueda"
                       class="form-control border-start-0"
                       placeholder="Buscar producto..."
                       value="@Request.QueryString["busqueda"]" />
            </div>
        </div>

        <div class="col-md-3">
            <select name="categoriaId" class="form-select">
                <option value="">Todas las categorías</option>

                @if (ViewBag.Categorias != null)
                {
                    foreach (var categoria in ViewBag.Categorias)
                    {
                        <option value="@categoria.Id">
                            @categoria.Nombre
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-outline-secondary w-100">

                <i class="bi bi-funnel me-1"></i>
                Filtrar
            </button>
        </div>

        <div class="col-md-2">

            @if (!string.IsNullOrEmpty(Request.QueryString["busqueda"])
                || !string.IsNullOrEmpty(Request.QueryString["categoriaId"]))
            {
                <a href="@Url.Action("Index", "Catalogo")"
                   class="btn btn-outline-danger w-100">

                    Limpiar
                </a>
            }

        </div>

    </div>
}

<div class="row">

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm border-0">

                    <img src="@item.ImagenPrincipal"
                         class="card-img-top"
                         style="height:250px; object-fit:cover;" />

                    <div class="card-body">

                        @if (item.PrecioDescuento.HasValue)
                        {
                            <span class="badge bg-danger mb-2">
                                Oferta
                            </span>
                        }

                        <h5 class="card-title">
                            @item.Nombre
                        </h5>

                        <p class="card-text text-muted">
                            @item.Descripcion
                        </p>

                        <p class="mb-2">
                            <strong>Categoría:</strong>
                            @item.CategoriaNombre
                        </p>

                        @if (item.PrecioDescuento.HasValue)
                        {
                            <p class="mb-2">

                                <span class="text-muted"
                                      style="text-decoration:line-through;">

                                    ₡@item.Precio.ToString("N0")
                                </span>

                                <strong class="text-danger fs-5 ms-1">
                                    ₡@item.PrecioDescuento.Value.ToString("N0")
                                </strong>

                            </p>
                        }
                        else
                        {
                            <p class="mb-2">
                                <strong class="fs-5">
                                    ₡@item.Precio.ToString("N0")
                                </strong>
                            </p>
                        }

                        @if (item.Disponible)
                        {
                            <span class="badge bg-success">
                                Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Agotado
                            </span>
                        }

                    </div>

                    <div class="card-footer bg-white border-0 text-center">

                        <a href="@Url.Action("Detalle", "Catalogo", new { id = item.ProductoId })"
                           class="btn btn-brand w-100">

                            Ver detalle
                        </a>

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="col-12">

            <div class="alert alert-warning text-center shadow-sm">

                <i class="bi bi-exclamation-circle me-2"></i>

                No se encontraron productos con los filtros aplicados.

            </div>

        </div>
    }

</div>