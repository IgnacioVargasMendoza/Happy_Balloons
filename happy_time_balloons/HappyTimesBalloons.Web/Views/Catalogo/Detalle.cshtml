@model HappyTimesBalloons.Abstraccion.DTOs.CatalogoProductoDTO

@{
    ViewBag.Title = "Detalle Producto";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-md-6">
            <img src="@Model.ImagenPrincipal"
                 class="img-fluid rounded shadow"
                 alt="@Model.Nombre" />
        </div>

        <div class="col-md-6">

            <h2>@Model.Nombre</h2>

            <p class="text-muted">
                @Model.CategoriaNombre
            </p>

            <p>
                @Model.Descripcion
            </p>

            @if (Model.PrecioDescuento.HasValue)
            {
                <p>
                    <span style="text-decoration:line-through;">
                        ₡@Model.Precio
                    </span>

                    <strong class="text-danger fs-4">
                        ₡@Model.PrecioDescuento
                    </strong>
                </p>
            }
            else
            {
                <p class="fs-4">
                    <strong>
                        ₡@Model.Precio
                    </strong>
                </p>
            }

            @if (Model.Disponible)
            {
                <span class="badge bg-success">
                    Disponible
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Agotado
                </span>
            }

            <div class="mt-4">
                <a href="@Url.Action("Index", "Catalogo")"
                   class="btn btn-brand w-100">
                    Volver al catálogo
                </a>
            </div>

        </div>
    </div>
</div>