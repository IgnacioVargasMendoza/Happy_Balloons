@model HappyTimesBalloons.Web.Models.ViewModels.ProductoIndexViewModel
@{
    ViewBag.Title = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam me-2 text-brand"></i>Productos</h2>
        <p class="text-muted small mb-0">Gestión del catálogo de productos</p>
    </div>
    @Html.ActionLink("Nuevo producto", "Crear", "Producto",
        null, new { @class = "btn btn-brand" })
</div>

@* Filtros *@
@using (Html.BeginForm("Index", "Producto", FormMethod.Get))
{
    <div class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="busqueda" class="form-control border-start-0"
                       placeholder="Buscar productos..." value="@Model.Busqueda" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoriaId" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.Value"
                            @(c.Selected ? "selected" : "")>@c.Text</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(Model.Busqueda) || Model.CategoriaId.HasValue)
            {
                @Html.ActionLink("Limpiar", "Index", "Producto", null,
                    new { @class = "btn btn-outline-danger ms-1" })
            }
        </div>
    </div>
}

@* Tabla *@
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" style="width:60px"></th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Productos.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-box-seam fs-3 d-block mb-2 opacity-25"></i>
                            @if (!string.IsNullOrEmpty(Model.Busqueda) || Model.CategoriaId.HasValue)
                            {
                                <span>Sin resultados para los filtros aplicados</span>
                            }
                            else
                            {
                                <span>No hay productos registrados</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(p.ImagenPrincipal))
                                {
                                    <img src="@p.ImagenPrincipal" alt="@p.Nombre"
                                         class="rounded" style="width:48px;height:48px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                         style="width:48px;height:48px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@p.Nombre</div>
                                @if (!string.IsNullOrEmpty(p.Descripcion))
                                {
                                    <div class="text-muted small">
                                        @(p.Descripcion.Length > 60
                                            ? p.Descripcion.Substring(0, 60) + "…"
                                            : p.Descripcion)
                                    </div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@p.CategoriaNombre</span></td>
                            <td class="text-end">
                                @if (p.TieneDescuento)
                                {
                                    <div class="text-muted text-decoration-line-through small">₡@p.Precio.ToString("N0")</div>
                                    <div class="fw-semibold text-success">₡@p.PrecioDescuento.Value.ToString("N0")</div>
                                }
                                else
                                {
                                    <div class="fw-semibold">₡@p.Precio.ToString("N0")</div>
                                }
                            </td>
                            <td class="text-center">
                                <span class="@(p.Stock < 5 ? "text-danger fw-semibold" : "")">
                                    @p.Stock
                                </span>
                            </td>
                            <td>
                                @if (p.EsActivo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="bi bi-dash-circle me-1"></i>Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Registrar", "MovimientosInventario", new { productoId = p.Id })"
                                   class="btn btn-sm btn-outline-secondary me-1"
                                   title="Registrar movimiento de inventario">
                                    <i class="bi bi-arrow-left-right"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary me-1 btn-editar"
                                        data-id="@p.Id"
                                        data-nombre="@Html.AttributeEncode(p.Nombre)"
                                        data-descripcion="@Html.AttributeEncode(p.Descripcion)"
                                        data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-precio-descuento="@(p.PrecioDescuento.HasValue ? p.PrecioDescuento.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-categoria-id="@p.CategoriaId"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEditar"
                                        title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                @using (Html.BeginForm("ToggleEstado", "Producto",
                                    new { id = p.Id }, FormMethod.Post,
                                    new { @class = "d-inline", id = "fToggle_" + p.Id }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            class="btn btn-sm @(p.EsActivo ? "btn-outline-warning" : "btn-outline-success") btn-toggle"
                                            data-form-id="fToggle_@p.Id"
                                            data-accion="@(p.EsActivo ? "desactivar" : "activar")"
                                            data-nombre="@Html.AttributeEncode(p.Nombre)"
                                            title="@(p.EsActivo ? "Desactivar" : "Activar")">
                                        <i class="bi @(p.EsActivo ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Productos.Any())
    {
        <div class="card-footer text-muted small">
            @Model.Productos.Count producto(s) encontrado(s)
        </div>
    }
</div>

<!-- Contenedores de imágenes por producto (ocultos, se clonan al abrir el modal) -->
@foreach (var p in Model.Productos)
{
    <div id="imgs-@p.Id" class="d-none">
        @if (p.Imagenes != null && p.Imagenes.Any())
        {
            <div class="row g-2">
                @foreach (var img in p.Imagenes)
                {
                    <div class="col-4">
                        <div class="position-relative">
                            <img src="@img.RutaImagen"
                                 alt="Imagen"
                                 class="img-thumbnail w-100"
                                 style="height:90px;object-fit:cover;" />

                            @if (img.EsPrincipal)
                            {
                                <span class="position-absolute top-0 start-0 badge"
                                      style="font-size:0.6rem;background:#e91e8c;">
                                    Principal
                                </span>
                            }

                            <div class="d-flex gap-1 mt-1">
                                @if (!img.EsPrincipal)
                                {
                                    <form action="@Url.Action("EstablecerPrincipal", "Producto")"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="imagenId" value="@img.Id" />
                                        <input type="hidden" name="productoId" value="@p.Id" />
                                        <input type="hidden" name="from" value="index" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary w-100"
                                                style="font-size:0.7rem;padding:1px 4px;"
                                                title="Marcar como principal">
                                            <i class="bi bi-star"></i>
                                        </button>
                                    </form>
                                }

                                <form action="@Url.Action("EliminarImagen", "Producto")"
                                      method="post"
                                      class="d-inline form-del-img">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="imagenId" value="@img.Id" />
                                    <input type="hidden" name="productoId" value="@p.Id" />
                                    <input type="hidden" name="from" value="index" />

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger w-100 btn-del-img"
                                            style="font-size:0.7rem;padding:1px 4px;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">Sin imágenes</p>
        }
    </div>
}

<!-- MODAL EDITAR -->
<div class="modal fade"
     id="modalEditar"
     tabindex="-1"
     aria-labelledby="lblModalEditar"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="lblModalEditar">
                    <i class="bi bi-pencil-square me-2 text-brand"></i>
                    Editar producto
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                @using (Html.BeginForm(
                    "Editar",
                    "Producto",
                    FormMethod.Post,
                    new { id = "formEditar", enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="editId"
                           name="Id" />

                    <div class="mb-3">
                        <label for="editNombre"
                               class="form-label fw-semibold">
                            Nombre
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="editNombre"
                               name="Nombre"
                               class="form-control"
                               maxlength="200"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editDescripcion"
                               class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea id="editDescripcion"
                                  name="Descripcion"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editPrecio"
                                   class="form-label fw-semibold">
                                Precio
                                <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">₡</span>

                                <input type="number"
                                       id="editPrecio"
                                       name="Precio"
                                       class="form-control"
                                       min="0.01"
                                       step="0.01"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="editPrecioDescuento"
                                   class="form-label fw-semibold">
                                Precio con descuento
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">₡</span>

                                <input type="number"
                                       id="editPrecioDescuento"
                                       name="PrecioDescuento"
                                       class="form-control"
                                       min="0"
                                       step="0.01" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Stock</label>
                            <div class="form-control-plaintext text-muted small">
                                El stock se gestiona mediante movimientos de inventario.
                                <a href="@Url.Action("Index", "Inventario")" class="ms-1">Ver inventario</a>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="editCategoriaId"
                                   class="form-label fw-semibold">
                                Categoría
                                <span class="text-danger">*</span>
                            </label>

                            <select id="editCategoriaId"
                                    name="CategoriaId"
                                    class="form-select"
                                    required>
                                <option value="">-- Selecciona --</option>

                                @foreach (var cat in Model.Categorias)
                                {
                                    <option value="@cat.Value">@cat.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-1 mt-3">
                        <label for="editInputImagenes"
                               class="form-label fw-semibold">
                            Agregar imágenes
                        </label>

                        <p class="text-muted small mb-1">JPG, PNG o WEBP · máx. 5 MB</p>

                        <input type="file"
                               name="imagenes"
                               id="editInputImagenes"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               multiple />

                        <div id="editPrevisualizacion"
                             class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>
                }

                <hr class="my-3" />

                <div class="mb-1">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-images me-1"></i>Imágenes actuales
                    </label>

                    <div id="modalImagenes" class="text-muted small">
                        Sin imágenes
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="submit"
                        form="formEditar"
                        class="btn btn-brand">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

@section scripts {
<script>
    function cablearBotonesEliminar(contenedor) {

        contenedor.querySelectorAll('.btn-del-img').forEach(function (btn) {

            btn.addEventListener('click', function () {

                if (confirm('¿Eliminar esta imagen?')) {

                    this.closest('.form-del-img').submit();
                }
            });
        });
    }

    document.querySelectorAll('.btn-editar').forEach(function (btn) {

        btn.addEventListener('click', function () {

            document.getElementById('editId').value =
                this.dataset.id;

            document.getElementById('editNombre').value =
                this.dataset.nombre;

            document.getElementById('editDescripcion').value =
                this.dataset.descripcion || '';

            document.getElementById('editPrecio').value =
                this.dataset.precio;

            document.getElementById('editPrecioDescuento').value =
                this.dataset.precioDescuento || '';

            document.getElementById('editCategoriaId').value =
                this.dataset.categoriaId;

            var contenedor = document.getElementById('modalImagenes');
            var fuente = document.getElementById('imgs-' + this.dataset.id);

            if (fuente) {
                contenedor.innerHTML = fuente.innerHTML;
                cablearBotonesEliminar(contenedor);
            } else {
                contenedor.innerHTML = '<p class="text-muted small mb-0">Sin imágenes</p>';
            }

            document.getElementById('editInputImagenes').value = '';
            document.getElementById('editPrevisualizacion').innerHTML = '';
        });
    });

    document.getElementById('editInputImagenes').addEventListener('change', function () {

        var previsualizacion = document.getElementById('editPrevisualizacion');
        previsualizacion.innerHTML = '';

        Array.from(this.files).forEach(function (file) {

            var reader = new FileReader();

            reader.onload = function (e) {

                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText =
                    'width:70px;height:70px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6;';
                previsualizacion.appendChild(img);
            };

            reader.readAsDataURL(file);
        });
    });

    document.querySelectorAll('.btn-toggle').forEach(function (btn) {

        btn.addEventListener('click', function () {

            if (confirm('¿Deseas ' + this.dataset.accion + ' el producto "' + this.dataset.nombre + '"?')) {

                document.getElementById(this.dataset.formId).submit();
            }
        });
    });
</script>
}
