@model HappyTimesBalloons.Web.Models.ViewModels.ProductoFormViewModel
@{
    ViewBag.Title = "Editar Producto";
}

<div class="d-flex align-items-center mb-4 gap-2">
    <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-secondary btn-sm" title="Volver">
        <i class="bi bi-chevron-left"></i>
    </a>
    <h2 class="mb-0"><i class="bi bi-pencil-square me-2 text-brand"></i>Editar producto</h2>
</div>

<div class="row g-4">
    @* ── Columna izquierda: datos + subida de imágenes ── *@
    <div class="col-lg-7">
        @using (Html.BeginForm("Editar", "Producto", FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Información del producto</div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Nombre,
                            new { @class = "form-control", maxlength = "200" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Descripcion, 4, 0, new { @class = "form-control" })
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Precio, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                @Html.TextBoxFor(m => m.Precio,
                                    new { @class = "form-control", type = "number",
                                          min = "0.01", step = "0.01" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.PrecioDescuento, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                @Html.TextBoxFor(m => m.PrecioDescuento,
                                    new { @class = "form-control", type = "number",
                                          min = "0", step = "0.01" })
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Stock, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Stock,
                                new { @class = "form-control", type = "number", min = "0" })
                            @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.CategoriaId, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(m => m.CategoriaId, Model.Categorias,
                                "-- Selecciona --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.CategoriaId, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">Agregar imágenes</div>
                <div class="card-body">
                    <p class="text-muted small">JPG, PNG o WEBP · máx. 5 MB</p>
                    <input type="file" name="imagenes" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" multiple id="inputImagenes" />
                    <div id="previsualizacion" class="d-flex flex-wrap gap-2 mt-3"></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-brand">
                    <i class="bi bi-check-lg me-1"></i> Guardar cambios
                </button>
                @Html.ActionLink("Cancelar", "Index", "Producto", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>

    @* ── Columna derecha: gestión de imágenes existentes ── *@
    <div class="col-lg-5">
        @if (Model.ImagenesExistentes.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-semibold">
                    <i class="bi bi-images me-1"></i>Imágenes actuales
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var img in Model.ImagenesExistentes)
                        {
                            <div class="col-4">
                                <div class="position-relative">
                                    <img src="@img.RutaImagen" alt="Imagen"
                                         class="img-thumbnail w-100"
                                         style="height:90px;object-fit:cover;" />
                                    @if (img.EsPrincipal)
                                    {
                                        <span class="position-absolute top-0 start-0 badge bg-brand"
                                              style="font-size:0.6rem;background:#e91e8c;">
                                            Principal
                                        </span>
                                    }
                                    <div class="d-flex gap-1 mt-1">
                                        @if (!img.EsPrincipal)
                                        {
                                            <form action="@Url.Action("EstablecerPrincipal", "Producto")" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="imagenId" value="@img.Id" />
                                                <input type="hidden" name="productoId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-xs btn-outline-primary w-100"
                                                        style="font-size:0.7rem;padding:1px 4px;"
                                                        title="Marcar como principal">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            </form>
                                        }
                                        <form action="@Url.Action("EliminarImagen", "Producto")" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="imagenId" value="@img.Id" />
                                            <input type="hidden" name="productoId" value="@Model.Id" />
                                            <button type="button"
                                                    class="btn btn-xs btn-outline-danger w-100 btn-del-img"
                                                    style="font-size:0.7rem;padding:1px 4px;"
                                                    data-form-id="delImg_@img.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
    document.getElementById('inputImagenes').addEventListener('change', function () {
        var contenedor = document.getElementById('previsualizacion');
        contenedor.innerHTML = '';
        Array.from(this.files).forEach(function (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText = 'width:70px;height:70px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6;';
                contenedor.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    });

    document.querySelectorAll('.btn-del-img').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (confirm('¿Eliminar esta imagen?')) {
                this.closest('form').submit();
            }
        });
    });
</script>
}
