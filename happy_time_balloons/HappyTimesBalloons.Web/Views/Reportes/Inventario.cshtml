@model HappyTimesBalloons.Web.Models.ViewModels.ReporteInventarioViewModel
@{
    ViewBag.Title = "Reporte de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-boxes me-2"></i>Reporte de Inventario</h2>
        @if (Model.TieneDatos)
        {
            <a href="@Url.Action("ExportarCsvInventario", "Reportes", new { categoriaId = Model.CategoriaId, estadoStock = Model.EstadoStock })"
               class="btn btn-success">
                <i class="bi bi-download me-1"></i>Exportar CSV
            </a>
        }
    </div>

    @Html.Partial("~/Views/Shared/_Mensajes.cshtml")

    @* Filtros *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Inventario", "Reportes")" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Categoría</label>
                    <select name="categoriaId" class="form-select">
                        <option value="">Todas las categorías</option>
                        @foreach (SelectListItem cat in Model.Categorias)
                        {
                            if (cat.Selected)
                            {
                                <option value="@cat.Value" selected="selected">@cat.Text</option>
                            }
                            else
                            {
                                <option value="@cat.Value">@cat.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Estado de stock</label>
                    <select name="estadoStock" class="form-select">
                        <option value="todos" @(Model.EstadoStock == "todos" ? "selected" : "")>Todos</option>
                        <option value="bajo" @(Model.EstadoStock == "bajo" ? "selected" : "")>Stock bajo</option>
                        <option value="sinStock" @(Model.EstadoStock == "sinStock" ? "selected" : "")>Sin stock</option>
                        <option value="normal" @(Model.EstadoStock == "normal" ? "selected" : "")>Normal</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    @if (Model.FiltroAplicado)
                    {
                        <a href="@Url.Action("Inventario", "Reportes")" class="btn btn-outline-secondary" title="Limpiar filtros">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.TieneDatos)
    {
        <div class="text-center py-5">
            <i class="bi bi-box-seam fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">Sin productos en el filtro seleccionado</h5>
            <p class="text-muted small">Prueba cambiando la categoría o el estado de stock.</p>
            @if (Model.FiltroAplicado)
            {
                <a href="@Url.Action("Inventario", "Reportes")" class="btn btn-outline-secondary btn-sm mt-2">
                    <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                </a>
            }
        </div>
    }
    else
    {
        @* KPIs *@
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 bg-primary bg-opacity-10 h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-primary">@Model.Reporte.TotalProductos</div>
                        <div class="text-muted small">Total productos</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-warning bg-opacity-10 h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-warning">@Model.Reporte.ProductosStockBajo</div>
                        <div class="text-muted small">Stock bajo</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-danger bg-opacity-10 h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-danger">@Model.Reporte.ProductosSinStock</div>
                        <div class="text-muted small">Sin stock</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-success bg-opacity-10 h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-success">
                            @(Model.Reporte.TotalProductos - Model.Reporte.ProductosStockBajo - Model.Reporte.ProductosSinStock)
                        </div>
                        <div class="text-muted small">Stock normal</div>
                    </div>
                </div>
            </div>
        </div>

        @* Tabla de productos *@
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-table me-1"></i>Detalle de inventario
                @if (Model.Reporte.NombreCategoria != null)
                {
                    <span class="badge bg-secondary ms-2">@Model.Reporte.NombreCategoria</span>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock actual</th>
                                <th class="text-center">Stock mínimo</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Reporte.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NombreProducto</td>
                                    <td><span class="badge bg-light text-dark">@item.Categoria</span></td>
                                    <td class="text-center">@item.StockActual</td>
                                    <td class="text-center text-muted">@item.StockMinimo</td>
                                    <td class="text-center">
                                        @if (item.EstadoStock == "Sin stock")
                                        {
                                            <span class="badge bg-danger">Sin stock</span>
                                        }
                                        else if (item.EstadoStock == "Stock bajo")
                                        {
                                            <span class="badge bg-warning text-dark">Stock bajo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Normal</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
