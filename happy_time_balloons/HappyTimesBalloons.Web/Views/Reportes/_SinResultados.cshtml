@model HappyTimesBalloons.Web.Models.ViewModels.ReporteVentasViewModel
<div class="text-center py-5">
    <i class="bi bi-bar-chart-line fs-1 text-muted"></i>
    <h5 class="mt-3 text-muted">Sin pedidos entregados en el período seleccionado</h5>
    <p class="text-muted small">
        @Model.FechaInicio.ToString("dd/MM/yyyy") — @Model.FechaFin.ToString("dd/MM/yyyy")
    </p>
    @if (Model.FiltroAplicado)
    {
        <a href="@Url.Action("Ventas", "Reportes")" class="btn btn-outline-secondary btn-sm mt-2">
            <i class="bi bi-x-circle me-1"></i>Limpiar filtros
        </a>
    }
</div>
