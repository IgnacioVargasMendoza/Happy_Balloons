@model HappyTimesBalloons.Web.Models.ViewModels.UsuariosRolViewModel
@{
    ViewBag.Title = "Asignación de roles";
}

<div class="d-flex align-items-center mb-4">
    <a href="@Url.Action("Index", "Rol")" class="btn btn-outline-secondary me-3" title="Volver">
        <i class="bi bi-chevron-left"></i>
    </a>
    <div>
        <h2 class="mb-0"><i class="bi bi-people me-2 text-brand"></i>Asignación de roles</h2>
        <p class="text-muted small mb-0">Gestione los roles asignados a cada usuario</p>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Usuarios.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                No hay usuarios registrados.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol actual</th>
                        <th class="text-end">Asignar rol</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td class="align-middle fw-semibold">
                                <i class="bi bi-person-circle me-2 text-muted"></i>@usuario.Nombre
                            </td>
                            <td class="align-middle text-muted small">@usuario.Email</td>
                            <td class="align-middle">
                                @if (usuario.Roles.Any())
                                {
                                    foreach (var rol in usuario.Roles)
                                    {
                                        <span class="badge bg-brand-soft text-brand me-1">@rol</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Sin rol</span>
                                }
                            </td>
                            <td class="text-end align-middle">
                                <div class="d-flex gap-1 justify-content-end">

                                    <select class="form-select form-select-sm"
                                            style="max-width:160px;"
                                            id="rol-@usuario.Id">
                                        <option value="">— Seleccionar —</option>
                                        @foreach (var rol in Model.RolesDisponibles)
                                        {
                                            var seleccionado = usuario.Roles.Contains(rol.Nombre);
                                            <option value="@rol.Nombre" @(seleccionado ? "selected" : "")>
                                                @rol.Nombre
                                            </option>
                                        }
                                    </select>

                                    <form action="@Url.Action("AsignarRol", "Rol")" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                        <input type="hidden" name="rolNombre" class="rol-oculto-@usuario.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-brand"
                                                onclick="document.querySelector('.rol-oculto-@usuario.Id').value = document.querySelector('#rol-@usuario.Id').value;"
                                                title="Asignar rol seleccionado">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                    @foreach (var rolActual in usuario.Roles)
                                    {
                                        <form action="@Url.Action("RevocarRol", "Rol")" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                            <input type="hidden" name="rolNombre" value="@rolActual" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Revocar @rolActual">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
