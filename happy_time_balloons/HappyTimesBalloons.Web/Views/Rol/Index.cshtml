@model HappyTimesBalloons.Web.Models.ViewModels.RolIndexViewModel
@{
    ViewBag.Title = "Gestión de roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-shield-lock me-2 text-brand"></i>Roles</h2>
        <p class="text-muted small mb-0">Administración de roles del sistema</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Usuarios", "Rol")" class="btn btn-outline-secondary">
            <i class="bi bi-people me-1"></i>Asignar usuarios
        </a>
        <a href="@Url.Action("Crear", "Rol")" class="btn btn-brand">
            <i class="bi bi-plus-lg me-1"></i>Nuevo rol
        </a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Roles.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-shield-x fs-1 d-block mb-2"></i>
                No hay roles registrados.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Rol</th>
                        <th class="text-center">Usuarios</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model.Roles)
                    {
                        <tr>
                            <td class="fw-semibold align-middle">
                                <i class="bi bi-shield me-2 text-muted"></i>@rol.Nombre
                            </td>
                            <td class="text-center align-middle">
                                <span class="badge bg-secondary rounded-pill">@rol.CantidadUsuarios</span>
                            </td>
                            <td class="text-end align-middle">
                                <a href="@Url.Action("Editar", "Rol", new { id = rol.Id })"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (rol.CantidadUsuarios == 0)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-rol-id="@rol.Id"
                                            data-rol-nombre="@rol.Nombre">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled
                                            title="No se puede eliminar: tiene usuarios asignados">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Eliminar rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Confirma que desea eliminar el rol <strong id="nombreRolEliminar"></strong>?
                Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                @using (Html.BeginForm("Eliminar", "Rol", FormMethod.Post, new { id = "formEliminar" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="inputRolId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/Scripts/Rol/rol-index.js"></script>
}
