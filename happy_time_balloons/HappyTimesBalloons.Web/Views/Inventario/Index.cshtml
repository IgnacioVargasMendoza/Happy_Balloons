@model HappyTimesBalloons.Web.Models.ViewModels.InventarioIndexViewModel
@{
    ViewBag.Title = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool hayFiltros = !string.IsNullOrEmpty(Model.Busqueda)
                   || Model.CategoriaId.HasValue
                   || Model.EstadoStock != "todos";

    int productosNormal = Model.Kpis.TotalProductos
                        - Model.Kpis.ProductosStockBajo
                        - Model.Kpis.ProductosSinStock;
    if (productosNormal < 0)
    {
        productosNormal = 0;
    }

    var gruposCategoria = Model.Items
        .GroupBy(i => i.CategoriaNombre ?? "Sin categoría")
        .OrderByDescending(g => g.Count())
        .ToList();

    var criticos = Model.Items
        .Where(i => i.StockMinimo > 0)
        .OrderBy(i => (double)i.StockActual / i.StockMinimo)
        .Take(10)
        .ToList();
}
@functions {
    string LabelJs(string s) {
        return "\"" + System.Web.HttpUtility.JavaScriptStringEncode(s ?? "") + "\"";
    }
}

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4 gap-2">
        <i class="bi bi-boxes fs-3 text-primary"></i>
        <h1 class="h3 mb-0">Inventario</h1>
    </div>

    @* ─────────────────────────────────────────────── KPI Cards ─── *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10">
                        <i class="bi bi-box-seam fs-4 text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total productos</div>
                        <div class="fs-4 fw-bold">@Model.Kpis.TotalProductos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10">
                        <i class="bi bi-exclamation-triangle fs-4 text-warning"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Stock bajo</div>
                        <div class="fs-4 fw-bold text-warning">@Model.Kpis.ProductosStockBajo</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-danger bg-opacity-10">
                        <i class="bi bi-slash-circle fs-4 text-danger"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Sin stock</div>
                        <div class="fs-4 fw-bold text-danger">@Model.Kpis.ProductosSinStock</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10">
                        <span class="fs-4 fw-bold text-success lh-1">₡</span>
                    </div>
                    <div>
                        <div class="text-muted small">Valor total</div>
                        <div class="fs-4 fw-bold text-success">₡@Model.Kpis.ValorTotalInventario.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────── Tabs ─── *@
    <ul class="nav nav-tabs" id="inventarioTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-inventario-btn" data-bs-toggle="tab"
                    data-bs-target="#pane-inventario" type="button" role="tab">
                <i class="bi bi-table me-1"></i>Inventario
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-analisis-btn" data-bs-toggle="tab"
                    data-bs-target="#pane-analisis" type="button" role="tab">
                <i class="bi bi-bar-chart-line me-1"></i>Análisis
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom bg-white shadow-sm p-4 mb-4">

        @* ──────────────────────────────────── Tab Inventario ─── *@
        <div class="tab-pane fade show active" id="pane-inventario" role="tabpanel">

            @* Alertas de reabastecimiento *@
            @if (Model.Kpis.AlertasReabastecimiento.Any())
            {
                <div class="card border-warning shadow-sm mb-4">
                    <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill text-warning"></i>
                        <span class="fw-semibold">Alertas de reabastecimiento</span>
                        <span class="badge bg-warning text-dark ms-auto">@Model.Kpis.AlertasReabastecimiento.Count</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th class="text-center">Stock Actual</th>
                                    <th class="text-center">Stock Mínimo</th>
                                    <th class="text-center">Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alerta in Model.Kpis.AlertasReabastecimiento)
                                {
                                    <tr>
                                        <td>@alerta.ProductoNombre</td>
                                        <td>@alerta.CategoriaNombre</td>
                                        <td class="text-center fw-semibold">@alerta.StockActual</td>
                                        <td class="text-center">@alerta.StockMinimo</td>
                                        <td class="text-center">
                                            @if (alerta.EstadoStock == "sin_stock")
                                            {
                                                <span class="badge bg-danger">Sin stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Stock bajo</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-registrar-mov"
                                                    data-producto-id="@alerta.ProductoId"
                                                    data-producto-nombre="@Html.AttributeEncode(alerta.ProductoNombre)"
                                                    data-stock-actual="@alerta.StockActual"
                                                    title="Registrar movimiento">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* Filtros *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index", "Inventario")" class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small text-muted mb-1">Buscar producto</label>
                            <input type="text"
                                   name="busqueda"
                                   value="@Model.Busqueda"
                                   class="form-control form-control-sm"
                                   placeholder="Nombre del producto..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Categoría</label>
                            <select name="categoriaId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">Todas las categorías</option>
                                @if (Model.Categorias != null)
                                {
                                    foreach (SelectListItem cat in Model.Categorias)
                                    {
                                        <option value="@cat.Value"
                                                @(cat.Selected ? "selected" : "")>
                                            @cat.Text
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted mb-1">Estado de stock</label>
                            <select name="estadoStock" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="todos" @(Model.EstadoStock == "todos" ? "selected" : "")>Todos</option>
                                <option value="bajo" @(Model.EstadoStock == "bajo" ? "selected" : "")>Stock bajo</option>
                                <option value="sin_stock" @(Model.EstadoStock == "sin_stock" ? "selected" : "")>Sin stock</option>
                            </select>
                        </div>
                        <div class="col-auto d-flex align-items-end">
                            <a href="@Url.Action("Index", "Inventario")" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @* Tabla principal *@
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">
                        Productos en inventario
                        <span class="badge bg-secondary ms-2">@Model.Items.Count</span>
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th class="text-center">Estado</th>
                                <th>Última Actualización</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                        No se encontraron productos con los filtros aplicados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    string rowClass = "";
                                    if (item.EstadoStock == "sin_stock")
                                    {
                                        rowClass = "table-danger";
                                    }
                                    else if (item.EstadoStock == "bajo")
                                    {
                                        rowClass = "table-warning";
                                    }

                                    <tr class="@rowClass">
                                        <td class="fw-semibold">@item.ProductoNombre</td>
                                        <td>@item.CategoriaNombre</td>
                                        <td class="text-center fw-bold">@item.StockActual</td>
                                        <td class="text-center text-muted">@item.StockMinimo</td>
                                        <td class="text-center">
                                            @if (item.EstadoStock == "sin_stock")
                                            {
                                                <span class="badge bg-danger">Sin stock</span>
                                            }
                                            else if (item.EstadoStock == "bajo")
                                            {
                                                <span class="badge bg-warning text-dark">Stock bajo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Normal</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @item.FechaUltimaActualizacion.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-end pe-3">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary me-1 btn-editar-minimo"
                                                    data-id="@item.Id"
                                                    data-producto-nombre="@Html.AttributeEncode(item.ProductoNombre)"
                                                    data-stock-minimo="@item.StockMinimo"
                                                    title="Editar stock mínimo">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-registrar-mov"
                                                    data-producto-id="@item.ProductoId"
                                                    data-producto-nombre="@Html.AttributeEncode(item.ProductoNombre)"
                                                    data-stock-actual="@item.StockActual"
                                                    title="Registrar movimiento">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        @* ──────────────────────────────────────── Tab Análisis ─── *@
        <div class="tab-pane fade" id="pane-analisis" role="tabpanel">

            @if (hayFiltros)
            {
                <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        Los gráficos muestran los <strong>@Model.Items.Count producto(s)</strong> que coinciden con los filtros activos.
                        <a href="@Url.Action("Index", "Inventario")" class="alert-link ms-1">Ver todos</a>
                    </span>
                </div>
            }

            <div class="row g-4 mb-4">
                @* Donut — Estado de stock *@
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">
                            <i class="bi bi-pie-chart me-1 text-primary"></i>Estado de stock
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <canvas id="chartEstado" style="max-height:280px"></canvas>
                        </div>
                    </div>
                </div>
                @* Bar — Productos por categoría *@
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">
                            <i class="bi bi-bar-chart me-1 text-primary"></i>Productos por categoría
                        </div>
                        <div class="card-body">
                            <canvas id="chartCategorias" style="max-height:280px"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            @* Horizontal bar — Productos más críticos *@
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
                    Productos más críticos (stock actual vs. mínimo)
                </div>
                <div class="card-body">
                    @if (!criticos.Any())
                    {
                        <p class="text-center text-muted py-3 mb-0">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                            Todos los productos están sobre su stock mínimo.
                        </p>
                    }
                    else
                    {
                        <canvas id="chartCriticos" style="max-height:340px"></canvas>
                    }
                </div>
            </div>

        </div>
    </div>

</div>

@* ──────────────────────────── Modal Editar Stock Mínimo ─── *@
<div class="modal fade" id="modalStockMinimo" tabindex="-1" aria-labelledby="modalStockMinimoLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalStockMinimoLabel">
                    <i class="bi bi-pencil me-2 text-secondary"></i>Editar stock mínimo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("EditarStockMinimo", "Inventario")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="minId" name="id" />
                <div class="modal-body">
                    <p class="fw-semibold mb-3" id="minNombreDisplay"></p>
                    <div>
                        <label for="minStockMinimo" class="form-label fw-semibold">
                            Stock mínimo <span class="text-danger">*</span>
                        </label>
                        <input type="number" class="form-control" id="minStockMinimo"
                               name="stockMinimo" min="0" step="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ───────────────────────────── Modal Registrar Movimiento ─── *@
<div class="modal fade" id="modalMovimiento" tabindex="-1" aria-labelledby="modalMovimientoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" id="movModalHeader">
                <h5 class="modal-title" id="modalMovimientoLabel">
                    <i class="bi bi-arrow-left-right me-2" id="movModalIcono"></i>
                    <span id="movModalTitulo">Registrar movimiento</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("Registrar", "MovimientosInventario")" method="post" id="formMovimiento">
                @Html.AntiForgeryToken()
                <input type="hidden" id="movProductoId" name="ProductoId" />
                <input type="hidden" id="movProductoNombre" name="ProductoNombre" />
                <input type="hidden" id="movStockActual" name="StockActual" />
                <div class="modal-body">

                    @* Producto + stock *@
                    <div class="rounded-3 border bg-light px-3 py-2 mb-4 d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2 bg-white border">
                            <i class="bi bi-box-seam fs-5 text-secondary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-muted" style="font-size:.75rem">Producto</div>
                            <div class="fw-semibold" id="movNombreDisplay"></div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted" style="font-size:.75rem">Stock actual</div>
                            <div class="fs-4 fw-bold lh-1" id="movStockDisplay"></div>
                            <div class="text-muted" style="font-size:.7rem">unidades</div>
                        </div>
                    </div>

                    @* Tipo de movimiento — tarjetas *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold mb-2">
                            Tipo de movimiento <span class="text-danger">*</span>
                        </label>
                        <div class="row g-2">
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="TipoMovimiento"
                                       id="movEntrada" value="0" autocomplete="off" />
                                <label for="movEntrada"
                                       class="btn btn-outline-success w-100 d-flex flex-column align-items-center py-3 gap-1">
                                    <i class="bi bi-arrow-down-circle fs-4"></i>
                                    <span class="fw-semibold">Entrada</span>
                                    <small class="opacity-75">Suma al stock</small>
                                </label>
                            </div>
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="TipoMovimiento"
                                       id="movSalida" value="1" autocomplete="off" />
                                <label for="movSalida"
                                       class="btn btn-outline-danger w-100 d-flex flex-column align-items-center py-3 gap-1">
                                    <i class="bi bi-arrow-up-circle fs-4"></i>
                                    <span class="fw-semibold">Salida</span>
                                    <small class="opacity-75">Resta del stock</small>
                                </label>
                            </div>
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="TipoMovimiento"
                                       id="movAjuste" value="2" autocomplete="off" />
                                <label for="movAjuste"
                                       class="btn btn-outline-warning w-100 d-flex flex-column align-items-center py-3 gap-1">
                                    <i class="bi bi-clipboard-check fs-4"></i>
                                    <span class="fw-semibold">Corrección</span>
                                    <small class="opacity-75">Suma al stock</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    @* Cantidad *@
                    <div class="mb-3">
                        <label for="movCantidad" class="form-label fw-semibold" id="movCantidadLabel">
                            Cantidad <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text" id="movCantidadPrefijo">
                                <i class="bi bi-hash text-muted"></i>
                            </span>
                            <input type="number" class="form-control form-control-lg"
                                   id="movCantidad" name="Cantidad" step="1"
                                   placeholder="0" />
                        </div>
                        <div class="form-text text-muted" id="movCantidadHint">
                            Selecciona el tipo de movimiento primero.
                        </div>
                    </div>

                    @* Preview antes → después *@
                    <div id="movPreviewStock" class="rounded-3 border p-3 mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="text-center flex-fill">
                                <div class="text-muted small mb-1">Antes</div>
                                <div class="fs-4 fw-bold" id="movPreviewAntes"></div>
                                <div class="text-muted" style="font-size:.7rem">unidades</div>
                            </div>
                            <div class="d-flex flex-column align-items-center gap-1">
                                <span id="movDeltaBadge" class="badge fs-6 px-3"></span>
                                <i class="bi bi-arrow-right fs-5 text-muted"></i>
                            </div>
                            <div class="text-center flex-fill">
                                <div class="text-muted small mb-1">Después</div>
                                <div class="fs-4 fw-bold" id="movStockResultante"></div>
                                <div class="text-muted" style="font-size:.7rem">unidades</div>
                            </div>
                        </div>
                    </div>

                    @* Alerta stock insuficiente *@
                    <div id="movAlertaStock" class="alert alert-danger d-none py-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span id="movAlertaTexto"></span>
                    </div>

                    @* Motivo *@
                    <div class="mb-1">
                        <label for="movMotivo" class="form-label fw-semibold">
                            Motivo <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="movMotivo" name="Motivo" rows="3"
                                  placeholder="Describe el motivo del movimiento..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" id="movBtnSubmit">
                        <i class="bi bi-check-lg me-1"></i>
                        <span id="movBtnTexto">Registrar movimiento</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    var initialized = false;

    function initCharts() {
        if (initialized) { return; }
        initialized = true;

        // ── Donut: estado de stock ──────────────────────────────────────────
        new Chart(document.getElementById('chartEstado'), {
            type: 'doughnut',
            data: {
                labels: ['Normal', 'Stock bajo', 'Sin stock'],
                datasets: [{
                    data: [@productosNormal, @Model.Kpis.ProductosStockBajo, @Model.Kpis.ProductosSinStock],
                    backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                    borderWidth: 2
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } },
                cutout: '60%'
            }
        });

        // ── Bar: productos por categoría ────────────────────────────────────
        new Chart(document.getElementById('chartCategorias'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", gruposCategoria.Select(g => LabelJs(g.Key))))],
                datasets: [{
                    label: 'Productos',
                    data: [@Html.Raw(string.Join(",", gruposCategoria.Select(g => g.Count())))],
                    backgroundColor: 'rgba(13,110,253,0.5)',
                    borderColor: '#0d6efd',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // ── Horizontal bar: productos más críticos ──────────────────────────
        var canvasCriticos = document.getElementById('chartCriticos');
        if (canvasCriticos) {
            new Chart(canvasCriticos, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", criticos.Select(p => LabelJs(p.ProductoNombre))))],
                    datasets: [
                        {
                            label: 'Stock actual',
                            data: [@Html.Raw(string.Join(",", criticos.Select(p => p.StockActual)))],
                            backgroundColor: 'rgba(220,53,69,0.6)',
                            borderColor: '#dc3545',
                            borderWidth: 1
                        },
                        {
                            label: 'Stock mínimo',
                            data: [@Html.Raw(string.Join(",", criticos.Select(p => p.StockMinimo)))],
                            backgroundColor: 'rgba(108,117,125,0.3)',
                            borderColor: '#6c757d',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { x: { beginAtZero: true } }
                }
            });
        }
    }

    // Inicializar solo cuando el tab de Análisis sea visible
    document.getElementById('tab-analisis-btn').addEventListener('shown.bs.tab', initCharts);
}());

(function () {
    var modalMinimo = new bootstrap.Modal(document.getElementById('modalStockMinimo'));

    document.querySelectorAll('.btn-editar-minimo').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('minId').value = this.dataset.id;
            document.getElementById('minNombreDisplay').textContent = this.dataset.productoNombre;
            document.getElementById('minStockMinimo').value = this.dataset.stockMinimo;
            modalMinimo.show();
        });
    });
}());

(function () {
    var modal = new bootstrap.Modal(document.getElementById('modalMovimiento'));
    var stockActualModal = 0;

    var TIPOS = {
        0: { color: 'success', icono: 'bi-arrow-down-circle', titulo: 'Registrar entrada',              btn: 'Registrar entrada',              hint: 'Ingresa la cantidad de unidades que ingresan al inventario.' },
        1: { color: 'danger',  icono: 'bi-arrow-up-circle',   titulo: 'Registrar salida',               btn: 'Registrar salida',               hint: 'Ingresa la cantidad de unidades que salen del inventario.' },
        2: { color: 'warning', icono: 'bi-clipboard-check',   titulo: 'Corrección de inventario',       btn: 'Registrar corrección',           hint: 'Ingresa la cantidad correcta de unidades a agregar al inventario.' }
    };

    function actualizarTipo(tipo) {
        var cfg = TIPOS[tipo];
        var header = document.getElementById('movModalHeader');
        var icono = document.getElementById('movModalIcono');
        var titulo = document.getElementById('movModalTitulo');
        var hint = document.getElementById('movCantidadHint');
        var btnTexto = document.getElementById('movBtnTexto');
        var inputCantidad = document.getElementById('movCantidad');

        header.className = 'modal-header bg-' + cfg.color + ' bg-opacity-10 border-' + cfg.color;
        icono.className = 'bi ' + cfg.icono + ' me-2 text-' + cfg.color;
        titulo.textContent = cfg.titulo;
        hint.textContent = cfg.hint;
        btnTexto.textContent = cfg.btn;

        inputCantidad.min = '1';
    }

    function actualizarPreview() {
        var tipoRadio = document.querySelector('input[name="TipoMovimiento"]:checked');
        var cantidadVal = parseInt(document.getElementById('movCantidad').value, 10);
        var preview = document.getElementById('movPreviewStock');
        var alerta = document.getElementById('movAlertaStock');
        var alertaTexto = document.getElementById('movAlertaTexto');
        var resultanteEl = document.getElementById('movStockResultante');
        var antesEl = document.getElementById('movPreviewAntes');
        var deltaEl = document.getElementById('movDeltaBadge');
        var btnSubmit = document.getElementById('movBtnSubmit');

        if (!tipoRadio || isNaN(cantidadVal)) {
            preview.classList.add('d-none');
            alerta.classList.add('d-none');
            btnSubmit.disabled = false;
            return;
        }

        var tipo = parseInt(tipoRadio.value, 10);
        var cfg = TIPOS[tipo];
        var resultante;
        if (tipo === 0) {
            resultante = stockActualModal + cantidadVal;
        } else if (tipo === 1) {
            resultante = stockActualModal - cantidadVal;
        } else {
            resultante = stockActualModal + cantidadVal;
        }

        var delta = resultante - stockActualModal;
        antesEl.textContent = stockActualModal;
        resultanteEl.textContent = resultante;

        var signo = delta >= 0 ? '+' : '';
        deltaEl.textContent = signo + delta;

        preview.classList.remove('d-none', 'border-success', 'border-danger', 'border-warning', 'bg-success-subtle', 'bg-danger-subtle');
        resultanteEl.className = 'fs-4 fw-bold';
        deltaEl.className = 'badge fs-6 px-3';

        if (resultante < 0) {
            preview.classList.add('border-danger', 'bg-danger-subtle');
            resultanteEl.classList.add('text-danger');
            deltaEl.classList.add('bg-danger');
            alertaTexto.textContent = 'Stock insuficiente. Disponible: ' + stockActualModal + ' uds. No es posible registrar esta salida.';
            alerta.classList.remove('d-none');
            btnSubmit.disabled = true;
        } else {
            var colorResultante = resultante === 0 ? 'warning' : 'success';
            preview.classList.add('border-' + colorResultante);
            resultanteEl.classList.add('text-' + colorResultante);
            deltaEl.classList.add('bg-' + cfg.color + (cfg.color === 'warning' ? ' text-dark' : ''));
            alerta.classList.add('d-none');
            btnSubmit.disabled = false;
        }
    }

    document.querySelectorAll('input[name="TipoMovimiento"]').forEach(function (r) {
        r.addEventListener('change', function () {
            actualizarTipo(parseInt(this.value, 10));
            actualizarPreview();
        });
    });
    document.getElementById('movCantidad').addEventListener('input', actualizarPreview);

    document.querySelectorAll('.btn-registrar-mov').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var productoId = this.dataset.productoId;
            var productoNombre = this.dataset.productoNombre;
            stockActualModal = parseInt(this.dataset.stockActual, 10) || 0;

            document.getElementById('movProductoId').value = productoId;
            document.getElementById('movProductoNombre').value = productoNombre;
            document.getElementById('movStockActual').value = stockActualModal;
            document.getElementById('movNombreDisplay').textContent = productoNombre;
            document.getElementById('movStockDisplay').textContent = stockActualModal;

            // Reset tipo
            document.querySelectorAll('input[name="TipoMovimiento"]').forEach(function (r) { r.checked = false; });
            var header = document.getElementById('movModalHeader');
            header.className = 'modal-header';
            document.getElementById('movModalIcono').className = 'bi bi-arrow-left-right me-2';
            document.getElementById('movModalTitulo').textContent = 'Registrar movimiento';
            document.getElementById('movBtnTexto').textContent = 'Registrar movimiento';
            document.getElementById('movCantidadHint').textContent = 'Selecciona el tipo de movimiento primero.';

            // Reset cantidad
            var inputCant = document.getElementById('movCantidad');
            inputCant.value = '';
            inputCant.min = '1';

            document.getElementById('movMotivo').value = '';
            document.getElementById('movPreviewStock').classList.add('d-none');
            document.getElementById('movAlertaStock').classList.add('d-none');
            document.getElementById('movBtnSubmit').disabled = false;

            modal.show();
        });
    });
}());
</script>
}
