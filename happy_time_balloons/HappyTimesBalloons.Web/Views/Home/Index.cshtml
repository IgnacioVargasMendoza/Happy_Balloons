@model HappyTimesBalloons.Web.Models.ViewModels.CatalogoIndexViewModel
@{
    ViewBag.Title = "Catálogo";
}

<div class="p-5 rounded-4 text-white mb-4"
     style="background: linear-gradient(135deg, #e91e8c, #9c27b0);">
    <h1 class="display-5 fw-bold">🎈 Happy Times Balloons</h1>
    <p class="lead opacity-90">Decoraciones mágicas para tus momentos especiales</p>
</div>

@using (Html.BeginForm("Index", "Home", FormMethod.Get))
{
    <div class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="busqueda" class="form-control border-start-0"
                       placeholder="Buscar productos..." value="@Model.Busqueda" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoriaId" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.Value"
                            @(c.Selected ? "selected" : "")>@c.Text</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(Model.Busqueda) || Model.CategoriaId.HasValue)
            {
                @Html.ActionLink("Limpiar", "Index", "Home", null,
                    new { @class = "btn btn-outline-danger ms-1" })
            }
        </div>
    </div>
}

@if (!Model.Productos.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-balloon fs-1 text-muted opacity-25 d-block mb-3"></i>
        <p class="text-muted">No hay productos disponibles en este momento.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var p in Model.Productos)
        {
            <div class="col">
                @Html.Partial("_TarjetaProducto", p)
            </div>
        }
    </div>
}

@if (Model.Paginacion != null)
{
    @Html.Partial("_Paginacion", Model.Paginacion)
}
