<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — Happy Times Balloons</title>

    <script>
        (function () {
            var t = localStorage.getItem('htb-theme') || 'light';
            var f = localStorage.getItem('htb-font') || 'md';
            document.documentElement.setAttribute('data-bs-theme', t);
            document.documentElement.classList.add('htb-font-' + f);
        }());
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link href="@Url.Content("~/Content/accessibility.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/feedback.css")" rel="stylesheet" />

    <style>

        .navbar-brand .bi {
            color: #e91e8c;
        }

        .btn-brand {
            background-color: #e91e8c;
            color: #fff;
            border-color: #e91e8c;
        }

            .btn-brand:hover {
                background-color: #c2177b;
                border-color: #c2177b;
                color: #fff;
            }

        .text-brand {
            color: #e91e8c !important;
        }

        .badge-cart {
            position: absolute;
            top: -6px;
            right: -6px;
            font-size: 0.65rem;
            min-width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    @Html.Partial("_NavBar")

    <main class="container py-4">
        @Html.Partial("_Mensajes")
        @RenderBody()
    </main>

    @Html.Partial("_Footer")

    @Html.Partial("_FeedbackModal")

    <button type="button" class="htb-feedback-btn" data-bs-toggle="modal"
            data-bs-target="#modalFeedback" title="Enviar feedback" aria-label="Enviar feedback">
        <i class="bi bi-chat-dots-fill"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="@Url.Content("~/Scripts/accessibility.js")"></script>
    <script src="@Url.Content("~/Scripts/feedback.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>