<footer class="bg-white border-top mt-5 py-4">
    <div class="container">
        <div class="row g-4">

            @* Columna 1: Marca + ubicación *@
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-balloon-heart-fill fs-4" style="color:#e91e8c;"></i>
                    <div class="lh-sm">
                        <div class="fw-bold">Happy Times Balloons</div>
                        <div class="text-muted" style="font-size:0.75rem;">Decoraciones y globos personalizados</div>
                    </div>
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-geo-alt me-1"></i>Mall San Pedro, primer piso (local Q27, frente a Super Salón)<br />
                    San Pedro, San José, Costa Rica
                </p>
            </div>

            @* Columna 2: Redes sociales *@
            <div class="col-md-4 text-md-center">
                <p class="fw-semibold small mb-2">Síguenos</p>
                <div class="d-flex gap-3 justify-content-md-center">
                    <a href="https://www.instagram.com/happytimesballoons"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="text-muted fs-5"
                       title="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="https://www.facebook.com/p/Happy-Times-Balloons-100077727878899/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="text-muted fs-5"
                       title="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                </div>
            </div>

            @* Columna 3: Links + copyright *@
            <div class="col-md-4 text-md-end">
                <ul class="list-inline mb-2 small">
                    <li class="list-inline-item">
                        @Html.ActionLink("Catálogo", "Index", "Home", null, new { @class = "text-muted text-decoration-none" })
                    </li>
                    <li class="list-inline-item">·</li>
                    <li class="list-inline-item">
                        @Html.ActionLink("Mi cuenta", "Login", "Cuenta", null, new { @class = "text-muted text-decoration-none" })
                    </li>
                </ul>
                <p class="text-muted small mb-0">
                    &copy; @DateTime.Now.Year — Happy Times Balloons
                </p>
            </div>

        </div>
    </div>
</footer>
