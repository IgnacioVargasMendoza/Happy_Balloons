@model HappyTimesBalloons.Web.Models.ViewModels.PrediccionDemandaDetalleViewModel
@{
    ViewBag.Title = "Detalle de Prediccion — " + Model.Detalle.NombreProducto;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/prediccion-demanda.css")" />

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "PrediccionDemanda", new { tipoPeriodo = Model.TipoPeriodoSeleccionado })">Prediccion de Demanda</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-0">
                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>@Model.Detalle.NombreProducto
            </h2>
            <p class="text-muted small mb-0">
                <span class="badge bg-light text-dark border">@Model.Detalle.Categoria</span>
                <span class="ms-2">Periodo: @Model.NombrePeriodo</span>
            </p>
        </div>
        <a href="@Url.Action("Index", "PrediccionDemanda", new { tipoPeriodo = Model.TipoPeriodoSeleccionado })"
           class="btn btn-outline-secondary">
            <i class="bi bi-chevron-left me-1"></i>Volver
        </a>
    </div>

    @if (!Model.Detalle.DatosSuficientes)
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@Model.Detalle.MensajeValidacion</div>
        </div>
    }
    else
    {
        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            <div>@Model.Detalle.MensajeValidacion</div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card prediccion-metrica-card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bullseye fs-2 text-primary mb-2"></i>
                    <div class="fs-3 fw-bold text-primary">
                        @if (Model.Detalle.DatosSuficientes)
                        {
                            <span>@Model.Detalle.CantidadPredichaProximoPeriodo.ToString("F1")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                    <div class="small text-muted">Prediccion proximo periodo</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card prediccion-metrica-card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calculator fs-2 text-success mb-2"></i>
                    <div class="fs-3 fw-bold text-success">
                        @if (Model.Detalle.DatosSuficientes)
                        {
                            <span>@Model.Detalle.PromedioHistorico.ToString("F1")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                    <div class="small text-muted">Promedio historico</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card prediccion-metrica-card h-100">
                <div class="card-body text-center">
                    @if (Model.Detalle.DatosSuficientes)
                    {
                        if (Model.Detalle.Tendencia > 0.5)
                        {
                            <i class="bi bi-arrow-up-circle fs-2 text-success mb-2"></i>
                            <div class="fs-3 fw-bold text-success">+@Model.Detalle.Tendencia.ToString("F1")</div>
                        }
                        else if (Model.Detalle.Tendencia < -0.5)
                        {
                            <i class="bi bi-arrow-down-circle fs-2 text-danger mb-2"></i>
                            <div class="fs-3 fw-bold text-danger">@Model.Detalle.Tendencia.ToString("F1")</div>
                        }
                        else
                        {
                            <i class="bi bi-arrow-right-circle fs-2 text-secondary mb-2"></i>
                            <div class="fs-3 fw-bold text-secondary">Estable</div>
                        }
                    }
                    else
                    {
                        <i class="bi bi-dash-circle fs-2 text-muted mb-2"></i>
                        <div class="fs-3 fw-bold text-muted">—</div>
                    }
                    <div class="small text-muted">Tendencia por periodo</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card prediccion-metrica-card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-range fs-2 text-info mb-2"></i>
                    <div class="fs-3 fw-bold text-info">@Model.Detalle.HistorialPeriodos.Count</div>
                    <div class="small text-muted">Periodos analizados</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Detalle.HistorialPeriodos != null && Model.Detalle.HistorialPeriodos.Count > 0)
    {
        var etiquetasJson = Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.Detalle.HistorialPeriodos.Select(p => p.EtiquetaPeriodo).ToList());
        var valoresJson = Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.Detalle.HistorialPeriodos.Select(p => p.CantidadVendida).ToList());
        var prediccionVal = Model.Detalle.DatosSuficientes
            ? Model.Detalle.CantidadPredichaProximoPeriodo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
            : "null";

        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-bar-chart-line me-2 text-primary"></i>Historial de ventas y proyeccion
                    </div>
                    <div class="card-body">
                        <div id="prediccion-grafico-data" class="d-none"
                             data-etiquetas="@etiquetasJson"
                             data-valores="@valoresJson"
                             data-prediccion="@prediccionVal">
                        </div>
                        <canvas id="chartHistorial" height="80"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">
                <i class="bi bi-table me-2"></i>Historial por periodo
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Periodo</th>
                                <th class="text-end">Cantidad vendida</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var periodo in Model.Detalle.HistorialPeriodos)
                            {
                                <tr>
                                    <td>@periodo.EtiquetaPeriodo</td>
                                    <td class="text-end fw-semibold">@periodo.CantidadVendida.ToString("F0")</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.Detalle.DatosSuficientes)
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <td class="fw-bold text-primary">
                                        <i class="bi bi-bullseye me-1"></i>Prediccion proximo periodo
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        @Model.Detalle.CantidadPredichaProximoPeriodo.ToString("F1")
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="@Url.Content("~/Scripts/prediccion-demanda.js")"></script>
}
