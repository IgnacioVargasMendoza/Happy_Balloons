@model HappyTimesBalloons.Web.Models.ViewModels.PrediccionDemandaViewModel
@using HappyTimesBalloons.Abstraccion.Enums
@{
    ViewBag.Title = "Prediccion de Demanda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/prediccion-demanda.css")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">
                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Prediccion de Demanda
            </h2>
            <p class="text-muted small mb-0">Proyeccion del proximo periodo basada en historial de ventas (promedio movil + tendencia lineal)</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <span class="fw-semibold me-2">Periodo:</span>
                <a href="@Url.Action("Index", "PrediccionDemanda", new { tipoPeriodo = TipoPeriodo.Semanal })"
                   class="btn @(Model.TipoPeriodoSeleccionado == TipoPeriodo.Semanal ? "btn-primary" : "btn-outline-primary") btn-sm">
                    <i class="bi bi-calendar-week me-1"></i>Semanal
                </a>
                <a href="@Url.Action("Index", "PrediccionDemanda", new { tipoPeriodo = TipoPeriodo.Mensual })"
                   class="btn @(Model.TipoPeriodoSeleccionado == TipoPeriodo.Mensual ? "btn-primary" : "btn-outline-primary") btn-sm">
                    <i class="bi bi-calendar-month me-1"></i>Mensual
                </a>
                <a href="@Url.Action("Index", "PrediccionDemanda", new { tipoPeriodo = TipoPeriodo.Trimestral })"
                   class="btn @(Model.TipoPeriodoSeleccionado == TipoPeriodo.Trimestral ? "btn-primary" : "btn-outline-primary") btn-sm">
                    <i class="bi bi-calendar3 me-1"></i>Trimestral
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-box-seam fs-2"></i>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalProductos</div>
                        <div class="small opacity-75">Productos analizados</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle fs-2"></i>
                    <div>
                        <div class="fs-4 fw-bold">@Model.ProductosConDatosSuficientes</div>
                        <div class="small opacity-75">Con datos suficientes</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle fs-2"></i>
                    <div>
                        <div class="fs-4 fw-bold">@(Model.TotalProductos - Model.ProductosConDatosSuficientes)</div>
                        <div class="small opacity-75">Con datos insuficientes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Predicciones == null || Model.Predicciones.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-graph-up fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No hay productos con ventas registradas</h5>
            <p class="text-muted small">Seleccione un periodo diferente o verifique que existan pedidos entregados.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header fw-semibold">
                <i class="bi bi-table me-2"></i>Predicciones — periodo @Model.NombrePeriodo
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th>Categoria</th>
                                <th class="text-end">Prediccion proximo periodo</th>
                                <th class="text-end">Promedio historico</th>
                                <th class="text-center">Tendencia</th>
                                <th class="text-center">Periodos analizados</th>
                                <th class="text-center">Accion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Predicciones)
                            {
                                <tr class="@(!item.DatosSuficientes ? "prediccion-fila-atenuada" : "")">
                                    <td class="fw-semibold">
                                        @item.NombreProducto
                                        @if (!item.DatosSuficientes)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Datos insuficientes</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.Categoria</span></td>
                                    <td class="text-end fw-bold">
                                        @if (item.DatosSuficientes)
                                        {
                                            <span>@item.CantidadPredichaProximoPeriodo.ToString("F1")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.DatosSuficientes)
                                        {
                                            <span>@item.PromedioHistorico.ToString("F1")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.DatosSuficientes)
                                        {
                                            if (item.Tendencia > 0.5)
                                            {
                                                <span class="badge prediccion-tendencia-alta">
                                                    <i class="bi bi-arrow-up-short"></i>+@item.Tendencia.ToString("F1")
                                                </span>
                                            }
                                            else if (item.Tendencia < -0.5)
                                            {
                                                <span class="badge prediccion-tendencia-baja">
                                                    <i class="bi bi-arrow-down-short"></i>@item.Tendencia.ToString("F1")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge prediccion-tendencia-estable">
                                                    <i class="bi bi-arrow-right-short"></i>Estable
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.PeriodosAnalizados</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Detalle", "PrediccionDemanda", new { id = item.ProductoId, tipoPeriodo = Model.TipoPeriodoSeleccionado })"
                                           class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/prediccion-demanda.js")"></script>
}
